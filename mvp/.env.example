# Mekong CLI Receipt Signing (REQUIRED for live execution receipts)
# HMAC-SHA256 key used to sign and verify command execution receipts.
# Without this, signReceiptPayload() and verifyReceiptSignature() will throw.
# Generate with:  openssl rand -hex 32
MEKONG_RECEIPT_HMAC_SECRET=
