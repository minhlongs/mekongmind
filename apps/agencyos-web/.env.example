# AgencyOS Web - Environment Variables
# Copy this file to .env.local and fill in actual values

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# RaaS Gateway API
NEXT_PUBLIC_RAAS_GATEWAY_URL="https://raas.agencyos.network"
NEXT_PUBLIC_RAAS_API_KEY=""

# Polar.sh Checkout (Billing)
NEXT_PUBLIC_BILLING_URL="https://buy.polar.sh/your-checkout-link"
POLAR_WEBHOOK_SECRET="whsec_your-webhook-secret-here"

# Vercel (Auto-injected in production)
# VERCEL_OIDC_TOKEN - Auto-generated by Vercel OIDC

# Optional: Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
