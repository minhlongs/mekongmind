# Algo-Trader Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=your_secure_redis_password_here

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=generate_random_256_bit_secret_here

# ============================================
# GRAFANA
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password

# ============================================
# DOMAIN (for SSL)
# ============================================
DOMAIN=algo-trader.yourdomain.com

# ============================================
# EXCHANGE API CREDENTIALS
# ============================================

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_api_secret

# ============================================
# OPTIONAL: ALERTING
# ============================================
# Telegram Bot (for trading alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
