{
  "name": "@mekong/lead-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute mekong-leads --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute mekong-leads --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
