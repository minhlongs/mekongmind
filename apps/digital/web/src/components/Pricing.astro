---
// Pricing — 3 Polar tiers: Free / Pro (highlighted) / Enterprise
---

<section
  id="pricing"
  class="py-16 md:py-24 bg-white"
  aria-labelledby="pricing-heading"
>
  <div class="container mx-auto px-4 md:px-6 max-w-6xl">
    <div class="text-center mb-12">
      <h2
        id="pricing-heading"
        class="text-3xl md:text-4xl font-semibold text-slate-900 leading-snug"
      >
        Simple usage-based pricing
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Start free. Scale as you grow. Powered by Polar.sh.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
      <!-- Free tier -->
      <div class="relative rounded-2xl border-2 border-slate-200 bg-white p-8 shadow-sm flex flex-col">
        <div>
          <h3 class="text-xl font-semibold text-slate-900">Free</h3>
          <p class="mt-2 text-sm text-slate-600">For evaluation & tinkering</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-slate-900">$0</span>
            <span class="text-sm text-slate-500">/month</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-slate-700" role="list">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              1,000 credits / month
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              All 25 MCP tools
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Community support (GitHub)
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              BYOK (bring your own API keys)
            </li>
          </ul>
        </div>
        <a
          href="https://polar.sh/mekongmind"
          class="mt-8 block w-full text-center rounded-lg border border-slate-300 px-6 py-3 font-semibold text-slate-900 hover:bg-slate-50 transition-colors duration-200 cursor-pointer"
        >
          Get Started Free
        </a>
      </div>

      <!-- Pro tier (highlighted) -->
      <div class="relative rounded-2xl border-2 border-sky-700 bg-white p-8 shadow-lg flex flex-col">
        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-sky-700 px-4 py-1 text-xs font-semibold text-white whitespace-nowrap">
          Most Popular
        </span>
        <div>
          <h3 class="text-xl font-semibold text-slate-900">Pro</h3>
          <p class="mt-2 text-sm text-slate-600">For startups & small teams</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-slate-900">$29</span>
            <span class="text-sm text-slate-500">/month</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-slate-700" role="list">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-sky-700 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              50,000 credits / month
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-sky-700 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Up to 3 team seats
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-sky-700 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Email support (24h response)
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-sky-700 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Usage analytics dashboard
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-sky-700 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Priority feature requests
            </li>
          </ul>
        </div>
        <a
          href="https://polar.sh/mekongmind"
          class="mt-8 block w-full text-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-600 transition-colors duration-200 cursor-pointer"
        >
          Subscribe to Pro
        </a>
      </div>

      <!-- Enterprise tier -->
      <div class="relative rounded-2xl border-2 border-slate-200 bg-white p-8 shadow-sm flex flex-col">
        <div>
          <h3 class="text-xl font-semibold text-slate-900">Enterprise</h3>
          <p class="mt-2 text-sm text-slate-600">For teams that need it all</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-slate-900">$199</span>
            <span class="text-sm text-slate-500">/month</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-slate-700" role="list">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Unlimited credits
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
