---
export interface Props {
  variant?: string;
}

const { variant = 'generic' } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? '';
---

<section
  id="contact"
  class="py-16 md:py-24 bg-sky-50"
  aria-labelledby="form-heading"
>
  <div class="container mx-auto px-4 md:px-6 max-w-6xl">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <h2
          id="form-heading"
          class="text-3xl md:text-4xl font-semibold text-slate-900 leading-snug"
        >
          Get early access
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Join the waitlist. We'll reach out within 24 hours.
        </p>
      </div>

      <form
        action={`${apiUrl}/api/lead`}
        method="POST"
        enctype="application/x-www-form-urlencoded"
        class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8 space-y-5"
        aria-label="Early access sign up"
        aria-describedby="form-status"
      >
        <input type="hidden" name="variant" value={variant} />
        <div class="space-y-1.5">
          <label for="name" class="block text-sm font-medium text-slate-700">
            Name <span class="text-red-600" aria-hidden="true">*</span>
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your full name"
            class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-sky-500 focus:outline-2 focus:outline-offset-0 focus:outline-sky-500 transition-colors duration-150"
          />
        </div>

        <div class="space-y-1.5">
          <label for="email" class="block text-sm font-medium text-slate-700">
            Email <span class="text-red-600" aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-sky-500 focus:outline-2 focus:outline-offset-0 focus:outline-sky-500 transition-colors duration-150"
          />
        </div>

        <div class="space-y-1.5">
          <label for="company" class="block text-sm font-medium text-slate-700">
            Company <span class="text-slate-400 font-normal">(optional)</span>
          </label>
          <input
            id="company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder="Startup name / Solo"
            class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-sky-500 focus:outline-2 focus:outline-offset-0 focus:outline-sky-500 transition-colors duration-150"
          />
        </div>

        <div class="space-y-1.5">
          <label for="use_case" class="block text-sm font-medium text-slate-700">
            What are you building? <span class="text-slate-400 font-normal">(optional)</span>
          </label>
          <textarea
            id="use_case"
            name="use_case"
            rows="3"
            maxlength="500"
            placeholder="e.g. AI customer support agent, automated content pipeline..."
            class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-sky-500 focus:outline-2 focus:outline-offset-0 focus:outline-sky-500 transition-colors duration-150 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg bg-sky-700 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 transition-colors duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Join waitlist
        </button>

        <div id="form-status" role="status" aria-live="polite" class="sr-only"></div>

        <p class="text-xs text-slate-500 text-center leading-relaxed">
          We'll never share your data. See our
          <a href="/privacy" class="text-sky-700 hover:underline cursor-pointer">Privacy Policy</a>.
        </p>
      </form>
    </div>
  </div>
</section>
