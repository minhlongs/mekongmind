---
// Footer — 3-col: Logo+Contact | Product | Legal
---

<footer class="bg-slate-900 text-slate-400" aria-label="Footer">
  <div class="container mx-auto px-4 md:px-6 max-w-6xl py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1: Logo + Contact -->
      <div>
        <a
          href="/"
          class="inline-block text-xl font-bold text-white hover:text-slate-200 transition-colors mb-4"
          aria-label="MekongMind — Home"
        >
          Mekong<span class="text-sky-400">Mind</span>
        </a>
        <p class="text-sm leading-relaxed mb-4">
          AI Agent Orchestration Platform. Build & deploy AI agents — zero infra.
        </p>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 flex-shrink-0" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:hello@mekongmind.com" class="hover:text-white transition-colors cursor-pointer">
              hello@mekongmind.com
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 flex-shrink-0" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582" />
            </svg>
            <a href="https://github.com/mekong-cli" class="hover:text-white transition-colors cursor-pointer" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Product -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Product</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services" class="hover:text-white transition-colors cursor-pointer">Services</a></li>
          <li><a href="/pricing" class="hover:text-white transition-colors cursor-pointer">Pricing</a></li>
          <li><a href="/docs" class="hover:text-white transition-colors cursor-pointer">Documentation</a></li>
          <li><a href="https://polar.sh/mekongmind" class="hover:text-white transition-colors cursor-pointer" target="_blank" rel="noopener noreferrer">Polar Checkout</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/privacy" class="hover:text-white transition-colors cursor-pointer">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="hover:text-white transition-colors cursor-pointer">Terms of Service</a>
          </li>
          <li>
            <a href="#contact" class="hover:text-white transition-colors cursor-pointer">Contact</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-slate-800 text-sm text-center">
      <p>© 2026 MekongMind</p>
    </div>
  </div>
</footer>
