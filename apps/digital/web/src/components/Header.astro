---
// Header — sticky nav with backdrop blur, mobile hamburger placeholder
---

<header class="sticky top-0 z-10 bg-white/80 backdrop-blur-md border-b border-slate-200">
  <nav
    class="container mx-auto flex h-16 items-center justify-between px-4 md:px-6 max-w-6xl"
    aria-label="Main navigation"
  >
    <!-- Wordmark logo: "MekongMind" with sky-700 dot -->
    <a
      href="/"
      class="text-xl font-bold text-slate-900 hover:text-slate-700 transition-colors"
      aria-label="MekongMind — Home"
    >
      Mekong<span class="text-sky-700">Mind</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden md:flex items-center gap-8">
      <a
        href="/services"
        class="text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors duration-150"
      >
        Services
      </a>
      <a
        href="/pricing"
        class="text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors duration-150"
      >
        Pricing
      </a>
      <a
        href="/docs"
        class="text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors duration-150"
      >
        Docs
      </a>
      <a
        href="https://github.com/mekong-cli/mekong-cli"
        class="text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors duration-150"
        target="_blank" rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        href="https://polar.sh/mekongmind"
        class="rounded-lg bg-sky-700 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600 transition-colors duration-150 cursor-pointer"
      >
        Get Started
      </a>
    </div>

    <!-- Mobile hamburger placeholder -->
    <button
      class="md:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="h-6 w-6"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
        />
      </svg>
    </button>
  </nav>

  <!-- Mobile nav links -->
  <div class="md:hidden border-t border-slate-100 bg-white/95">
    <div class="container mx-auto flex flex-col px-4 py-3 max-w-6xl gap-1">
      <a href="/services" class="py-2 text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors">Services</a>
      <a href="/pricing" class="py-2 text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors">Pricing</a>
      <a href="/docs" class="py-2 text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors">Docs</a>
      <a href="https://github.com/mekong-cli/mekong-cli" class="py-2 text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors">GitHub</a>
      <a href="https://polar.sh/mekongmind" class="mt-1 rounded-lg bg-sky-700 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-sky-600 transition-colors cursor-pointer">Get Started</a>
    </div>
  </div>
</header>
