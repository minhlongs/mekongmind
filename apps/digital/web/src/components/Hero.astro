---
export interface Props {
  variant?: string;
}

const { variant = 'generic' } = Astro.props;
import { heroContent } from '../lib/content';
const content = (heroContent as any)[variant] ?? heroContent.generic;
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-sky-50 to-white py-20 md:py-32"
  aria-labelledby="hero-heading"
>
  <div class="container mx-auto px-4 md:px-6 max-w-6xl">
    <div class="max-w-3xl">
      <!-- Eyebrow badge -->
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full bg-sky-100 px-3 py-1 text-sm font-medium text-sky-800"
      >
        <span class="h-2 w-2 rounded-full bg-sky-600 animate-pulse" aria-hidden="true"></span>
        {content.eyebrow}
      </div>

      <!-- Headline -->
      <h1
        id="hero-heading"
        class="text-5xl md:text-6xl font-bold tracking-tight text-slate-900 leading-tight"
      >
        {content.headline.split('—')[0]}
        {content.headline.includes('—') && (
          <>—&nbsp;<span class="text-sky-700">{content.headline.split('—')[1]?.trim()}</span></>
        )}
      </h1>

      <!-- Sub -->
      <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed max-w-2xl">
        {content.sub}
      </p>

      <!-- CTA buttons -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-lg bg-sky-700 px-8 py-4 text-base font-semibold text-white shadow-sm hover:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 transition-colors duration-200 cursor-pointer"
        >
          {content.cta1}
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-8 py-4 text-base font-semibold text-slate-900 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-sky-500 transition-colors duration-200 cursor-pointer"
        >
          {content.cta2}
        </a>
      </div>

      <!-- Trust strip -->
      <div class="mt-12 pt-6 border-t border-slate-200">
        <p class="text-xs uppercase tracking-wider text-slate-500 mb-4">Powered by</p>
        <div class="flex flex-wrap items-center gap-6 md:gap-8">
          <span class="text-sm font-semibold text-slate-400">Polar.sh</span>
          <span class="text-sm font-semibold text-slate-400">Anthropic</span>
          <span class="text-sm font-semibold text-slate-400">OpenAI</span>
          <span class="text-sm font-semibold text-slate-400">Cloudflare</span>
          <span class="text-sm font-semibold text-slate-400">MLX</span>
        </div>
      </div>
    </div>
  </div>
</section>
