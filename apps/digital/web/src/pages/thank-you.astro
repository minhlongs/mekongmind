---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Cảm ơn anh chị! — Mekong Digital"
  description="Chúng tôi đã nhận được yêu cầu tư vấn của anh chị và sẽ liên hệ trong 24 giờ."
>
  <Header />
  <main id="main-content" class="flex-1">
    <section class="py-24 md:py-32 bg-gradient-to-b from-sky-50 to-white">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-xl mx-auto text-center">
          <!-- Checkmark SVG -->
          <div class="mb-8 flex justify-center">
            <div class="h-20 w-20 rounded-full bg-green-100 flex items-center justify-center">
              <!-- Heroicons v2 outline: check 24px (scaled) -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-10 w-10 text-green-600"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m4.5 12.75 6 6 9-13.5"
                />
              </svg>
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight mb-4">
            Cảm ơn anh/chị!
          </h1>

          <p class="text-lg text-slate-600 leading-relaxed mb-8">
            Chúng tôi đã nhận được yêu cầu tư vấn. Đội ngũ Mekong Digital sẽ liên hệ với anh/chị
            trong vòng <strong class="text-slate-900">24 giờ làm việc</strong>.
          </p>

          <p class="text-base text-slate-500 mb-10">
            Trong lúc chờ đợi, anh/chị có thể xem thêm các dịch vụ và gói giá của chúng tôi.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-lg bg-sky-700 px-6 py-3 text-base font-semibold text-white hover:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 transition-colors duration-200 cursor-pointer"
            >
              Về trang chủ
            </a>
            <a
              href="/#services"
              class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-sky-500 transition-colors duration-200 cursor-pointer"
            >
              Xem dịch vụ
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
