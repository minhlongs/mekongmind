    }
  ],
  "mekongmind_department_capability_mesh": [
    {
      "department": "ceo-command",
      "purpose": "Turn founder intent into one active company command room before any department spends cycles.",
      "cells": [
        {
          "sop_stage": "idea-intake",
          "commands": [
            "idea",
            "goal"
          ],
          "agents": [
            "planner",
            "brainstormer"
          ],
          "proof": "raw idea captured with buyer, pain, target, constraints, and desired outcome",
          "gate": "company-blueprint",
          "handoff": [
            "company-blueprint"
          ],
          "failure_signal": "idea remains inspirational text without ICP, pain, target MRR, or kill criteria"
        },
        {
          "sop_stage": "company-blueprint",
          "commands": [
            "plan",
            "solo"
          ],
          "agents": [
            "planner",
            "project-manager"
          ],
          "proof": ".mekong/company.json and state/goal-*.md name the next department and current gate",
          "gate": "company-blueprint",
          "handoff": [
            "market-intelligence",
            "product-strategy"
          ],
          "failure_signal": "multiple active goals or unclear next bottleneck"
        },
        {
          "sop_stage": "gate-review",
          "commands": [
            "chain"
          ],
          "agents": [
            "planner",
            "code-reviewer"
          ],
          "proof": "CEO approval, exception, or kill note links to the gate evidence being reviewed",
          "gate": "company-blueprint",
          "handoff": [
            "market-intelligence",
            "quality-compliance"
          ],
          "failure_signal": "department claims ready without artifact contract"
        },
        {
          "sop_stage": "capital-allocation",
          "commands": [
            "plan"
          ],
          "agents": [
            "planner",
            "business-analyst"
          ],
          "proof": "time, budget, model, and constraint allocation recorded before build or launch",
          "gate": "company-blueprint",
          "handoff": [
            "product-strategy",
            "engineering-factory"
          ],
          "failure_signal": "engineering begins before offer validation or budget boundary"
        }
      ]
    },
    {
      "department": "market-intelligence",
