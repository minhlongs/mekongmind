    },
    {
      "source": "claudekit",
      "legacy_strength": "Strong full-stack, framework, database, testing, review, infrastructure, deployment, and runtime quality specialists.",
      "legacy_failure_if_alone": "Can ship code, tests, and infrastructure without proving ICP, paid demand, checkout, retention, or $1M MRR economics.",
      "merged_role": "Own the sellable product factory only after offer validation: MVP build, integrations, quality review, release approval, deployment, health, rollback, and monitoring.",
      "primary_departments": [
        "engineering-factory",
        "quality-compliance",
        "platform-operations"
      ],
      "command_groups": [
