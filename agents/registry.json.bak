  "mekongmind_operating_model": {
    "identity": "Agentic Platform Solo Company OS",
    "target": "first $1M MRR, then cloneable RaaS factory",
    "source_roles": [
      {
        "source": "mekong-cli",
        "role": "business revenue orchestration",
        "owns": [
          "idea",
          "market",
          "offer",
          "gtm",
          "sales",
          "revenue",
          "fulfillment",
          "multi-project-raas"
        ]
      },
      {
        "source": "claudekit",
        "role": "engineering verification factory",
        "owns": [
          "full-stack-code",
          "tests",
          "review",
          "infra",
          "deploy",
          "runtime-quality"
        ]
      },
      {
        "source": "me-wrapper",
        "role": "harness dna and command router",
        "owns": [
          "goal-state",
          "department-routing",
          "sop-gates",
          "evidence-contracts",
          "continuous-loop",
          "clone-memory"
        ]
      }
    ],
    "lifecycle": [
      {
        "stage": "idea-to-company",
        "departments": [
          "ceo-command"
        ],
        "gate": "company-blueprint",
        "outcome": "founder intent becomes one active company goal with constraints, target MRR, and gate map"
      },
      {
        "stage": "terrain-to-offer",
        "departments": [
          "market-intelligence",
          "product-strategy"
        ],
        "gate": "offer-validated",
        "outcome": "ICP, pain, wedge, pricing, and sellable RaaS offer are validated before build"
      },
      {
        "stage": "offer-to-product",
        "departments": [
          "engineering-factory",
          "quality-compliance",
          "platform-operations"
        ],
        "gate": "mvp-live",
        "outcome": "minimum sellable full-stack product is built, tested, deployed, observed, and recoverable"
      },
      {
        "stage": "product-to-revenue",
        "departments": [
          "growth-marketing",
          "sales-revenue"
        ],
        "gate": "first-revenue",
        "outcome": "repeatable channel evidence and checkout/sales loop produce MRR"
      },
      {
        "stage": "revenue-to-retention",
        "departments": [
          "customer-success"
        ],
        "gate": "fulfillment-stable",
        "outcome": "customer outcome is delivered without founder bottleneck"
      },
      {
        "stage": "retention-to-clone",
        "departments": [
          "knowledge-memory"
        ],
        "gate": "scale-ready",
        "outcome": "SOPs, decisions, and playbooks are extracted so the next CEO Solo clone can reuse the DNA"
      }
    ],
    "operating_layers": [
      {
        "layer": "L0",
        "name": "Founder Intent Intake",
        "purpose": "Turn raw idea text into a durable CEO Solo Company goal without losing founder constraints.",
        "source_mix": [
          "me-wrapper",
          "mekong-cli"
        ],
        "departments": [
          "ceo-command"
        ],
        "commands": [
          "idea",
          "goal",
          "solo",
          "chain"
        ],
        "sop_focus": [
          "idea-intake",
          "target-mrr",
          "constraint-capture",
          "kill-criteria"
        ],
        "entry_signal": "founder enters idea or goal",
        "exit_gate": "company-blueprint",
        "handoff_to": [
          "market-intelligence",
          "product-strategy"
        ],
        "failure_signal": "goal lacks ICP, pain, target MRR, gate map, or kill criteria"
      },
      {
        "layer": "L1",
        "name": "Market Terrain And Offer",
        "purpose": "Convert Mekong CLI business breadth into a narrow sellable RaaS wedge before any full-stack build.",
        "source_mix": [
          "mekong-cli"
        ],
        "departments": [
          "market-intelligence",
          "product-strategy"
        ],
        "commands": [
          "research",
          "analysis",
          "business",
          "requirements",
          "pricing"
        ],
        "sop_focus": [
          "terrain-scan",
          "icp-validation",
          "offer-shape",
          "pricing-hypothesis",
          "no-build-without-demand"
        ],
        "entry_signal": "company blueprint exists",
        "exit_gate": "offer-validated",
        "handoff_to": [
          "engineering-factory",
          "quality-compliance",
          "platform-operations"
        ],
        "failure_signal": "offer cannot name buyer, urgent pain, alternative, wedge, price, and demand signal"
      },
      {
        "layer": "L2",
        "name": "Product Engineering Factory",
        "purpose": "Use ClaudeKit full-stack specialists only after offer proof, producing a sellable, tested, deployable MVP.",
        "source_mix": [
          "claudekit",
          "mekong-cli"
        ],
        "departments": [
          "engineering-factory",
          "quality-compliance",
          "platform-operations"
        ],
        "commands": [
          "nextjs",
          "react",
          "api",
          "database",
          "test",
          "review",
          "deploy",
          "github-actions"
        ],
        "sop_focus": [
          "architecture-slice",
          "implementation",
          "test-review",
          "deployment",
          "observability",
          "rollback"
        ],
        "entry_signal": "offer-validated artifact passes strict contract",
        "exit_gate": "mvp-live",
        "handoff_to": [
          "growth-marketing",
          "sales-revenue"
        ],
        "failure_signal": "product is code-complete but lacks tests, deploy proof, version match, health URL, or rollback plan"
      },
      {
        "layer": "L3",
        "name": "Revenue Capture Loop",
        "purpose": "Join Mekong GTM/revenue commands with live checkout evidence so the product becomes MRR instead of a demo.",
        "source_mix": [
          "mekong-cli",
          "me-wrapper"
        ],
        "departments": [
          "growth-marketing",
          "sales-revenue"
        ],
        "commands": [
          "marketing",
          "content",
          "growth",
          "sales",
          "revenue",
          "checkout",
          "billing"
        ],
        "sop_focus": [
          "channel-experiment",
          "lead-qualification",
          "sales-script",
          "checkout",
          "close",
          "mrr-review"
        ],
        "entry_signal": "mvp-live artifact passes strict contract",
        "exit_gate": "first-revenue",
        "handoff_to": [
          "customer-success"
        ],
        "failure_signal": "traffic exists but no qualified lead, checkout URL, payment status, provider, or current MRR evidence"
      },
      {
        "layer": "L4",
        "name": "Fulfillment And Retention",
        "purpose": "Prove customer outcome delivery so revenue is retained and founder does not become the bottleneck.",
        "source_mix": [
          "mekong-cli",
          "claudekit"
        ],
        "departments": [
          "customer-success"
        ],
        "commands": [
          "support",
          "triage",
          "tracking",
          "onboarding",
          "fulfillment"
        ],
        "sop_focus": [
          "onboarding",
          "delivery-tracking",
          "customer-feedback",
          "support-loop",
          "retention-risk"
        ],
        "entry_signal": "first-revenue artifact or revenue metric is present",
        "exit_gate": "fulfillment-stable",
        "handoff_to": [
          "knowledge-memory",
          "sales-revenue"
        ],
        "failure_signal": "customer paid but outcome, SLA, owner, escalation, or retention signal is missing"
      },
      {
        "layer": "L5",
        "name": "Clone Memory And Scale",
        "purpose": "Extract decisions, SOP changes, and reusable playbooks so Mekongmind can mint the next Solo CEO/RaaS clone.",
        "source_mix": [
          "me-wrapper",
          "mekong-cli"
        ],
        "departments": [
          "knowledge-memory"
        ],
        "commands": [
          "docs",
          "journal",
          "memory",
          "notes",
          "sop"
        ],
        "sop_focus": [
          "decision-log",
          "playbook-extraction",
          "sop-update",
          "clone-readiness",
          "next-bottleneck"
        ],
        "entry_signal": "fulfillment-stable artifact passes strict contract",
        "exit_gate": "scale-ready",
        "handoff_to": [
          "ceo-command"
        ],
        "failure_signal": "system works once but has no reusable playbook, SOP delta, open-question log, or clone readiness proof"
      }
    ],
    "revenue_ladder": [
      {
        "milestone": "first-paid-customer",
        "target_mrr": 1,
        "gate": "first-revenue",
        "departments": [
          "growth-marketing",
          "sales-revenue"
        ],
        "evidence": "provider-backed payment or signed paid commitment tied to lead, checkout URL, payment status, and current MRR",
        "sop_focus": [
          "qualified lead",
          "checkout",
          "close",
          "provider sync"
        ],
        "next_bottleneck": "prove the first customer pays for the RaaS promise"
      },
      {
        "milestone": "10k-mrr",
        "target_mrr": 10000,
        "gate": "repeatable-channel",
        "departments": [
          "growth-marketing",
          "sales-revenue",
          "customer-success"
        ],
        "evidence": "repeatable channel with qualified pipeline, close loop, active customers, and low manual delivery drag",
        "sop_focus": [
          "channel experiment",
          "sales script",
          "onboarding",
          "retention signal"
        ],
        "next_bottleneck": "turn first revenue into repeatable acquisition and delivery"
      },
      {
        "milestone": "100k-mrr",
        "target_mrr": 100000,
        "gate": "fulfillment-stable",
        "departments": [
          "sales-revenue",
          "customer-success",
          "platform-operations"
        ],
        "evidence": "MRR, fulfillment, support, uptime, and retention evidence show the company can grow without founder-only work",
        "sop_focus": [
          "sales ops",
          "fulfillment SOP",
          "support loop",
          "production reliability"
        ],
        "next_bottleneck": "remove founder bottlenecks from sales fulfillment and operations"
      },
      {
        "milestone": "300k-mrr",
        "target_mrr": 300000,
        "gate": "scale-ready",
        "departments": [
          "customer-success",
          "knowledge-memory",
          "platform-operations"
        ],
        "evidence": "playbooks, runbooks, metrics, and escalation rules are reusable across multiple RaaS projects",
        "sop_focus": [
          "playbook extraction",
          "ops review",
          "team handoff",
          "clone readiness"
        ],
        "next_bottleneck": "make the operating system cloneable across niches"
      },
      {
        "milestone": "first-1m-mrr",
        "target_mrr": 1000000,
        "gate": "first-1m-mrr",
        "departments": [
          "sales-revenue",
          "customer-success",
          "knowledge-memory",
          "ceo-command"
        ],
        "evidence": "provider-backed MRR reaches 1000000 and the operating cadence can preserve, expand, and clone the revenue engine",
        "sop_focus": [
          "MRR audit",
          "retention review",
          "expansion loop",
          "clone launch"
        ],
        "next_bottleneck": "preserve the $1M MRR system and mint the next Solo CEO clone"
      }
    ],
    "invariants": [
      "No command is naked: command -> agent -> department -> SOP -> gate.",
      "No engineering before offer validation unless CEO Command explicitly records exception evidence.",
      "No deploy is done until Quality & Compliance and Platform Operations can prove green release and health evidence.",
      "No $1M MRR claim is done until Sales & Revenue writes provider-backed MRR evidence.",
      "No clone is allowed until Knowledge & Memory records reusable SOP and decision evidence."
    ]
  },
  "mekongmind_evidence_contracts": [
    {
      "department": "ceo-command",
      "gate": "company-blueprint",
      "artifact_path": ".mekong/company.json",
      "required_fields": [
        "idea",
        "target_customer",
        "pain",
        "offer_direction",
        "target_mrr",
        "current_gate",
        "next_department",
        "kill_criteria"
      ],
      "proof_rule": "one active company goal with target, current gate, next department, and kill criteria"
    },
    {
      "department": "market-intelligence",
      "gate": "offer-validated",
      "artifact_path": "state/evidence/offer-validated.json",
      "required_fields": [
        "icp",
        "pain",
        "trigger",
        "buyer",
        "alternatives",
        "wedge",
