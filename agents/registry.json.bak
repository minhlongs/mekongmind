      ],
      "mrr_contribution": "Converts validated offer into a live, tested, observable, rollbackable product that Sales can safely sell and Customer Success can fulfill.",
      "anti_pattern": "Letting engineering start before offer proof or treating green code as revenue proof."
    },
    {
      "source": "me-wrapper",
      "legacy_strength": "Harness layer that can normalize command routing, state, gates, daemon loops, service contracts, evidence validation, and clone memory.",
      "legacy_failure_if_alone": "A wrapper without Mekong business motion and ClaudeKit engineering capacity only coordinates empty state; it cannot create demand, product, revenue, or fulfillment proof by itself.",
      "merged_role": "Act as the Mekongmind OS kernel: route command -> agent -> department -> SOP -> gate, enforce doctrine, keep state, run loops, verify evidence, and expose bottlenecks.",
      "primary_departments": [
        "ceo-command",
        "quality-compliance",
        "platform-operations",
        "knowledge-memory"
      ],
      "command_groups": [
        "solo",
        "chain",
        "commands",
        "capabilities",
        "mesh",
        "doctrine",
        "allow",
        "contract",
        "artifact",
        "gates",
        "loop",
        "daemon",
        "service",
        "ladder"
      ],
      "control_layers": [
        "goal_state",
        "department_ledger",
        "gate_state",
        "revenue_metrics",
        "strict_contracts",
        "continuous_loop",
        "launchagent_service"
      ],
      "mrr_contribution": "Keeps the whole factory from drifting: every action has owner, gate, proof, blocker, and next bottleneck until first $1M MRR evidence exists.",
      "anti_pattern": "Building more wrapper commands without enforcing proof, revenue, fulfillment, or clone outcomes."
    }
  ],
