          "agents": [
            "docs-manager",
            "documentation-expert"
          ],
          "proof": "SOP deltas are linked to actual evidence and bottlenecks",
          "gate": "scale-ready",
          "handoff": [
            "playbook-extract"
          ],
          "failure_signal": "SOPs drift from real execution"
        },
        {
          "sop_stage": "playbook-extract",
          "commands": [
            "docs",
            "journal"
          ],
          "agents": [
            "docs-manager",
            "journal-writer"
          ],
          "proof": "reusable playbook separates generic Mekongmind DNA from project-specific notes",
          "gate": "scale-ready",
          "handoff": [
            "clone-sync"
          ],
          "failure_signal": "playbook is project anecdote, not reusable operating system"
        },
        {
          "sop_stage": "clone-sync",
          "commands": [
            "goal",
            "solo"
          ],
          "agents": [
            "planner",
            "docs-manager"
          ],
          "proof": "clone readiness, open questions, next bottleneck, and next CEO Solo target are recorded",
          "gate": "scale-ready",
          "handoff": [
            "ceo-command"
          ],
          "failure_signal": "system cannot mint next niche/company from prior proof"
        }
      ]
    }
  ],
  "mekongmind_department_room_system": [
    {
      "department": "ceo-command",
      "room_type": "strategic command room",
      "queue_policy": "only one active company goal may own the factory at a time",
      "wip_limit": "1 active goal, 1 active gate exception, 1 current bottleneck",
      "intake_contract": "idea must name buyer hypothesis, pain, target outcome, constraints, and first $1M MRR intent",
      "operating_cadence": "open on every new idea, blocked gate, exception request, or MRR milestone",
      "checkpoint_stack": [
        "intake",
        "blueprint",
        "gate-review",
        "capital-allocation",
        "handoff"
      ],
      "decision_loop": "accept idea -> freeze company blueprint -> approve gate or kill -> assign next room -> record exception if doctrine is bypassed",
      "escalation_policy": "if ICP, target, budget, or kill criteria are missing, block downstream rooms until CEO evidence is written",
      "anti_chaos_rules": [
        "no parallel company goals",
        "no build before gate decision",
        "no vague objective without MRR target"
      ],
      "done_when": "company-blueprint evidence names target customer, pain, current gate, next room, target MRR, and kill criteria"
    },
    {
      "department": "market-intelligence",
      "room_type": "terrain and demand room",
      "queue_policy": "research only the active company goal and only questions that can change offer/build/sales decisions",
      "wip_limit": "2 active ICP hypotheses, 1 competitor map, 1 demand proof path",
      "intake_contract": "requires company blueprint, founder hypothesis, target customer guess, and constraints",
      "operating_cadence": "run before product strategy and whenever sales objections or channel data contradict the ICP",
      "checkpoint_stack": [
        "market-map",
        "customer-discovery",
        "competitor-scan",
        "demand-proof",
        "offer-handoff"
      ],
      "decision_loop": "narrow ICP -> test pain urgency -> compare alternatives -> score demand -> hand off or reject terrain",
      "escalation_policy": "if pain is weak, buyer unreachable, or wedge unclear, return to CEO Command with no-build recommendation",
      "anti_chaos_rules": [
        "no broad market essays",
        "no research without buyer decision",
        "no build signal from vanity TAM"
      ],
      "done_when": "offer-validated evidence contains ICP, pain, competitor wedge, demand signal, confidence, and next action"
    },
    {
      "department": "product-strategy",
      "room_type": "offer and RaaS blueprint room",
      "queue_policy": "accept only validated terrain or CEO exception; reject product scope that does not serve the sales promise",
      "wip_limit": "1 active offer, 1 pricing model, 1 MVP boundary",
      "intake_contract": "requires ICP, pain, wedge, demand proof, and known constraints",
      "operating_cadence": "run after market intelligence and whenever sales or fulfillment evidence invalidates the offer",
      "checkpoint_stack": [
        "offer-design",
        "pricing-model",
        "raas-blueprint",
        "roadmap",
        "engineering-handoff"
      ],
      "decision_loop": "shape promise -> price package -> define RaaS surface -> bound MVP -> hand off acceptance criteria",
      "escalation_policy": "if promise cannot be fulfilled or priced, send correction to Market Intelligence or CEO Command",
      "anti_chaos_rules": [
        "no feature roadmap without paid promise",
        "no free-demo default",
        "no MVP scope beyond first revenue proof"
      ],
      "done_when": "offer-validated evidence contains sellable offer, price, package, MVP acceptance criteria, and fulfillment path"
    },
    {
      "department": "engineering-factory",
      "room_type": "validated-offer product factory",
      "queue_policy": "only build against offer-validated acceptance criteria or explicit CEO exception",
      "wip_limit": "1 MVP workflow, 1 integration risk, 1 production hardening queue",
      "intake_contract": "requires offer brief, MVP acceptance criteria, checkout/provider expectation, and fulfillment boundary",
      "operating_cadence": "run after offer validation and re-open only for revenue, fulfillment, or production blockers",
      "checkpoint_stack": [
        "technical-design",
        "mvp-build",
        "integration",
        "production-hardening",
        "quality-handoff"
      ],
      "decision_loop": "design sellable workflow -> implement minimum path -> connect real integrations -> prove build/test -> hand off quality evidence",
      "escalation_policy": "if checkout, data, or delivery path is missing, block build and request product-strategy correction",
      "anti_chaos_rules": [
        "no coding from raw idea",
        "no demo-only product proof",
        "no mock integration as production evidence"
      ],
      "done_when": "mvp-live engineering evidence proves sellable workflow, integration status, build/test command, risks, and handoff notes"
    },
    {
      "department": "quality-compliance",
      "room_type": "release proof and risk room",
      "queue_policy": "review only code or artifacts tied to active gate proof and buyer/revenue flows",
      "wip_limit": "1 release candidate, 1 blocker list, 1 residual-risk register",
      "intake_contract": "requires MVP artifact, acceptance criteria, changed files, test scope, and risk notes",
      "operating_cadence": "run after engineering changes and before every deploy, checkout change, or provider integration change",
      "checkpoint_stack": [
        "review",
        "test",
        "security-scan",
        "audit-trail",
        "release-approval"
      ],
      "decision_loop": "review diff -> map tests to buyer flow -> scan risk -> record audit trail -> pass/block release",
      "escalation_policy": "if tests miss checkout, auth, provider, or fulfillment flow, block release and return to Engineering Factory",
      "anti_chaos_rules": [
        "no summary-only review",
        "no green tests without coverage of revenue path",
        "no security waiver without owner"
      ],
      "done_when": "mvp-live quality evidence records release decision, tests, review findings, security notes, residual risks, and owner"
    },
    {
      "department": "platform-operations",
      "room_type": "live service and operations room",
      "queue_policy": "deploy only release-approved artifacts with provider, commit, health URL, rollback, and monitoring plan",
      "wip_limit": "1 active deploy, 1 incident, 1 rollback path",
      "intake_contract": "requires release approval, commit, deployment target, build command, smoke path, and rollback owner",
      "operating_cadence": "run on every deploy, health regression, incident, or version mismatch",
      "checkpoint_stack": [
        "ci",
        "deploy",
        "health-check",
        "rollback",
        "ops-review"
      ],
      "decision_loop": "verify CI -> deploy current commit -> smoke health/version -> attach rollback -> publish operations review",
      "escalation_policy": "if production is not current, observable, or rollbackable, block Growth and Sales rooms",
      "anti_chaos_rules": [
        "no fabricated provider",
        "no HTTP 200 as sole proof",
        "no launch without rollback path"
      ],
      "done_when": "mvp-live operations evidence proves provider, commit, build ID, health URL, HTTP status, version match, rollback, and monitoring"
    },
    {
      "department": "growth-marketing",
      "room_type": "qualified demand generation room",
      "queue_policy": "launch only against live MVP, validated offer, ICP, CTA, and measurable qualification rule",
      "wip_limit": "2 active channels, 3 campaign assets, 1 experiment learning loop",
      "intake_contract": "requires live MVP, offer brief, ICP, pricing, customer proof or CEO-approved launch exception",
      "operating_cadence": "weekly experiments and after every material positioning, price, or ICP change",
      "checkpoint_stack": [
        "positioning",
        "content-engine",
        "campaign",
        "launch",
        "growth-experiment"
      ],
      "decision_loop": "position promise -> build CTA assets -> timebox campaign -> collect leads/conversion -> update next experiment",
      "escalation_policy": "if traffic does not qualify or objections repeat, return learning to Product Strategy and Market Intelligence",
      "anti_chaos_rules": [
        "no vanity traffic",
        "no unbounded campaign",
        "no content without CTA and qualification"
      ],
      "done_when": "repeatable-channel evidence records audience, positioning, channel, campaign, CTA, qualified leads, conversion, and learning"
    },
    {
      "department": "sales-revenue",
      "room_type": "checkout and MRR truth room",
      "queue_policy": "work only qualified demand, paid exceptions, or provider-backed revenue reconciliation",
      "wip_limit": "3 active revenue motions, 1 checkout blocker, 1 provider sync discrepancy",
      "intake_contract": "requires qualified lead, offer, price, checkout path, campaign source, and current provider expectation",
      "operating_cadence": "after every qualified lead, close, payment, refund, upgrade, churn, or provider sync",
      "checkpoint_stack": [
        "lead-qualification",
        "sales-script",
        "checkout",
        "close",
        "revenue-review"
      ],
      "decision_loop": "qualify buyer -> run script/objections -> verify checkout/provider -> close or route fix -> reconcile MRR evidence",
      "escalation_policy": "if buyer wants to pay but checkout/provider fails, block revenue claim and return to Engineering Factory plus Platform Operations",
      "anti_chaos_rules": [
        "no verbal yes as revenue",
        "no MRR without provider-backed evidence",
        "no scale claim before fulfillment proof"
      ],
      "done_when": "first-revenue evidence and revenue state agree on lead, offer, price, checkout URL, payment status, provider, current MRR, and next action"
    },
    {
      "department": "customer-success",
      "room_type": "fulfillment and retention room",
      "queue_policy": "accept only paid/signed customers or CEO-approved fulfillment probes with explicit promise and success metric",
      "wip_limit": "5 active onboardings, 5 support items, 2 retention risks",
      "intake_contract": "requires paid customer, customer promise, onboarding need, success metric, and delivery deadline",
      "operating_cadence": "after every new customer, support event, delivery milestone, renewal, expansion, or churn risk",
      "checkpoint_stack": [
        "onboarding",
        "fulfillment",
        "support",
        "retention",
        "expansion"
      ],
      "decision_loop": "start onboarding -> deliver promised outcome -> manage support -> assess retention -> route expansion/product learning",
      "escalation_policy": "if promise cannot be delivered repeatably, block scale-ready and return to Product Strategy or Engineering Factory",
      "anti_chaos_rules": [
        "no customer without owner",
        "no undocumented founder-only fulfillment",
        "no retention claim without signal"
      ],
      "done_when": "fulfillment-stable evidence proves onboarding, promise, delivery status, support owner, retention risk, and expansion signal"
    },
    {
      "department": "knowledge-memory",
      "room_type": "clone memory and SOP refinery room",
      "queue_policy": "record only decisions, SOP deltas, evidence learnings, and clone rules tied to passed/failed gates",
      "wip_limit": "1 decision log, 1 SOP delta batch, 1 clone-readiness packet",
      "intake_contract": "requires passed gates, department artifacts, customer outcomes, open questions, and SOP deltas",
      "operating_cadence": "after every gate pass, material failure, customer learning, incident, or clone handoff",
      "checkpoint_stack": [
        "decision-log",
        "sop-update",
        "playbook-extract",
        "clone-sync"
      ],
      "decision_loop": "capture decision -> update SOP delta -> extract reusable playbook -> mark clone readiness or next bottleneck",
      "escalation_policy": "if evidence is thin or project-specific, block clone claim and request missing department proof",
      "anti_chaos_rules": [
        "no playbook from anecdotes",
        "no clone without reusable SOP",
        "no memory update detached from evidence"
      ],
      "done_when": "scale-ready evidence proves decision log, SOP changes, reusable playbook, project notes, open questions, clone readiness, and next bottleneck"
    }
  ],
  "mekongmind_gate_execution_doctrine": [
    {
      "gate": "company-blueprint",
      "purpose": "Freeze one CEO Solo Company objective before market, product, or engineering work begins.",
      "entry_signal": "founder submits idea or goal",
      "exit_signal": ".mekong/company.json and state/goal-*.md contain target customer, pain, target MRR, current gate, next department, and kill criteria",
      "required_departments": [
        "ceo-command"
      ],
      "required_sop_stages": [
        "idea-intake",
        "company-blueprint",
        "gate-review",
        "capital-allocation"
      ],
      "allowed_command_groups": [
        "idea",
        "goal",
        "plan",
        "chain",
        "solo"
      ],
      "blocked_until_pass": [
        "market research without target customer",
        "product scope",
        "engineering build",
        "launch campaign"
      ],
      "proof_artifacts": [
        ".mekong/company.json",
        "state/goal-*.md",
        "state/gates/<goal-id>.json"
      ],
      "next_gate": "offer-validated",
      "failure_signal": "multiple active ideas, unclear ICP, no kill criteria, or no target MRR"
    },
    {
      "gate": "offer-validated",
      "purpose": "Prove a narrow ICP, painful wedge, sellable package, price, and MVP boundary before ClaudeKit builds.",
      "entry_signal": "company-blueprint passes",
      "exit_signal": "market-intelligence and product-strategy contracts both validate against state/evidence/offer-validated.json",
      "required_departments": [
        "market-intelligence",
        "product-strategy"
      ],
      "required_sop_stages": [
        "market-map",
        "customer-discovery",
        "competitor-scan",
        "demand-proof",
        "offer-design",
        "pricing-model",
        "raas-blueprint",
        "roadmap"
      ],
      "allowed_command_groups": [
        "research",
        "analysis",
        "investigate",
        "brainstorm",
        "business",
        "requirements",
        "product",
        "design",
        "pricing",
        "finance"
      ],
      "blocked_until_pass": [
        "MVP build",
        "deploy",
        "sales script",
        "paid launch"
      ],
      "proof_artifacts": [
        "state/evidence/offer-validated.json"
      ],
      "next_gate": "mvp-live",
      "failure_signal": "research exists but offer cannot name buyer, urgent pain, price, wedge, and acceptance criteria"
    },
    {
      "gate": "mvp-live",
      "purpose": "Prove the product is sellable, tested, deployed, observable, rollbackable, and tied to a commit.",
      "entry_signal": "offer-validated passes strict contract",
      "exit_signal": "engineering-factory, quality-compliance, and platform-operations contracts validate against state/evidence/mvp-live.json",
      "required_departments": [
        "engineering-factory",
        "quality-compliance",
        "platform-operations"
      ],
      "required_sop_stages": [
        "technical-design",
        "mvp-build",
        "integration",
        "production-hardening",
        "review",
        "test",
        "security-scan",
        "audit-trail",
        "release-approval",
        "ci",
        "deploy",
        "health-check",
        "rollback",
        "ops-review"
      ],
      "allowed_command_groups": [
        "web",
        "frontend",
        "backend",
        "api",
        "database",
        "ai",
        "nextjs",
        "react",
        "test",
        "build",
        "typescript",
        "review",
        "audit",
        "lint",
        "verify",
        "github",
        "deploy",
        "devops",
        "docker",
        "git",
        "tracking"
      ],
      "blocked_until_pass": [
        "growth campaign",
        "sales checkout push",
        "customer onboarding"
      ],
      "proof_artifacts": [
        "state/evidence/mvp-live.json",
        "production health URL",
        "build/test output"
      ],
      "next_gate": "repeatable-channel",
      "failure_signal": "code is done but lacks tests, health URL, provider, version match, rollback, or monitoring"
    },
    {
      "gate": "repeatable-channel",
      "purpose": "Prove a bounded acquisition loop that produces qualified demand instead of vanity traffic.",
      "entry_signal": "mvp-live passes strict contract",
      "exit_signal": "growth-marketing contract validates against state/evidence/repeatable-channel.json",
      "required_departments": [
        "growth-marketing"
      ],
      "required_sop_stages": [
        "positioning",
        "content-engine",
        "campaign",
        "launch",
        "growth-experiment"
      ],
      "allowed_command_groups": [
        "marketing",
        "content",
        "docs",
        "launch",
        "growth",
        "experiment"
      ],
      "blocked_until_pass": [
        "scaling spend",
        "claiming repeatability",
        "delegating sales volume"
      ],
      "proof_artifacts": [
        "state/evidence/repeatable-channel.json"
      ],
      "next_gate": "first-revenue",
      "failure_signal": "traffic or content exists but qualified lead, CTA, conversion, and learning are missing"
    },
    {
      "gate": "first-revenue",
      "purpose": "Convert qualified demand into paid, signed, or provider-backed revenue and update MRR truth.",
      "entry_signal": "repeatable-channel produces qualified leads or CEO records paid exception",
      "exit_signal": "sales-revenue contract validates and state/revenue/<goal-id>.json records current MRR source",
      "required_departments": [
        "sales-revenue"
      ],
      "required_sop_stages": [
        "lead-qualification",
        "sales-script",
        "checkout",
        "close",
        "revenue-review"
      ],
      "allowed_command_groups": [
        "sales",
        "pricing",
        "revenue",
        "finance"
      ],
      "blocked_until_pass": [
        "customer success completion claim",
        "MRR ladder progress beyond first customer",
        "clone readiness"
      ],
      "proof_artifacts": [
        "state/evidence/first-revenue.json",
        "state/revenue/<goal-id>.json",
        "provider checkout/subscription evidence"
      ],
      "next_gate": "fulfillment-stable",
      "failure_signal": "lead says yes but checkout URL, provider, payment status, current MRR, or next action is missing"
    },
    {
      "gate": "fulfillment-stable",
      "purpose": "Prove customer outcome delivery and retention path so revenue is durable, not founder-only hero work.",
      "entry_signal": "first-revenue passes or provider-backed MRR exists",
      "exit_signal": "customer-success contract validates against state/evidence/fulfillment-stable.json",
      "required_departments": [
        "customer-success"
      ],
      "required_sop_stages": [
        "onboarding",
        "fulfillment",
        "support",
        "retention",
        "expansion"
      ],
      "allowed_command_groups": [
        "support",
        "docs",
        "tracking",
        "triage",
        "sales",
        "revenue"
      ],
      "blocked_until_pass": [
        "scale-ready",
        "clone launch",
        "repeatable delivery claim"
      ],
      "proof_artifacts": [
        "state/evidence/fulfillment-stable.json"
      ],
      "next_gate": "scale-ready",
      "failure_signal": "paid customer exists but promise, owner, SLA, delivery status, support, or retention risk is unknown"
    },
    {
      "gate": "scale-ready",
      "purpose": "Extract reusable SOPs, decisions, playbooks, open questions, and clone readiness from the proven company loop.",
      "entry_signal": "fulfillment-stable passes",
      "exit_signal": "knowledge-memory contract validates against state/evidence/scale-ready.json",
      "required_departments": [
        "knowledge-memory"
      ],
      "required_sop_stages": [
        "decision-log",
        "sop-update",
        "playbook-extract",
        "clone-sync"
      ],
      "allowed_command_groups": [
        "journal",
        "notes",
        "docs",
        "documentation",
        "goal",
        "solo"
      ],
      "blocked_until_pass": [
        "next CEO Solo clone",
        "multi-project replication",
        "first-1m-mrr operating claim"
      ],
      "proof_artifacts": [
        "state/evidence/scale-ready.json",
        "docs/playbooks or SOP deltas"
      ],
      "next_gate": "first-1m-mrr",
      "failure_signal": "system worked once but has no reusable playbook, SOP delta, decision log, or clone bottleneck"
    },
    {
      "gate": "first-1m-mrr",
      "purpose": "Prove provider-backed $1M MRR and preserve the operating cadence that can retain, expand, and clone it.",
      "entry_signal": "scale-ready passes and revenue ladder reaches first-1m-mrr",
      "exit_signal": "provider-backed MRR reaches 1000000 with retention, fulfillment, memory, and CEO review evidence",
      "required_departments": [
        "sales-revenue",
        "customer-success",
        "knowledge-memory",
        "ceo-command"
      ],
      "required_sop_stages": [
        "revenue-review",
        "retention",
        "playbook-extract",
        "gate-review"
      ],
      "allowed_command_groups": [
        "revenue",
        "sales",
        "tracking",
        "docs",
        "journal",
        "goal",
        "solo"
      ],
      "blocked_until_pass": [
        "claiming objective complete",
        "selling Mekongmind as proven clone factory"
      ],
      "proof_artifacts": [
        "state/revenue/<goal-id>.json",
        "provider MRR export",
        "state/evidence/first-revenue.json",
        "state/evidence/fulfillment-stable.json",
        "state/evidence/scale-ready.json"
      ],
      "next_gate": "clone-launch",
      "failure_signal": "MRR claim lacks provider export, retention proof, fulfillment proof, or reusable operating DNA"
    }
  ],
  "mekongmind_source_fusion_matrix": [
    {
      "source": "mekong-cli",
      "legacy_strength": "Broad business, GTM, orchestration, revenue, fulfillment, audit, and multi-project RaaS command surface.",
      "legacy_failure_if_alone": "Too many commands without department ownership, gate order, evidence contracts, or command allow/block policy; business motion can become noisy activity instead of MRR.",
      "merged_role": "Own the revenue-facing operating rooms: CEO intent, market terrain, offer, GTM, sales, revenue, fulfillment, memory, and multi-project replication.",
      "primary_departments": [
        "ceo-command",
        "market-intelligence",
        "product-strategy",
        "growth-marketing",
        "sales-revenue",
        "customer-success",
        "knowledge-memory"
