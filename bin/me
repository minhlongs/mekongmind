#!/bin/bash
# ── me-deep-wrapper v1.0.0 — CEO Solo Company Orchestrator ─
# Wraps: mekong-cli + claudekit + claude
# Paradigm: /command + /idea (Harness Engineering)
# ─────────────────────────────────────────────────────────────
# me-deep-wrapper v1.0.0 — CEO Solo Company Orchestrator
# Wraps: mekong-cli + claudekit + claude
# Paradigm: /command + /idea (Harness Engineering)
# Source: walkinglabs/awesome-harness-engineering + Solo-Platform
# ─────────────────────────────────────────────────────────────
set -uo pipefail
set +u  # nounset breaks array access in run_idea
# Bust bash hash table so PATH changes (e.g. removing competing wrappers) take effect
hash -r 2>/dev/null || true
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
# Resolve WRAPPER_DIR from env, BASH_SOURCE, $0, or command -v.
# Priority:
#   1. Pre-set env vars (shell snapshot sets these to bypass $0 issues when sourced)
#   2. $0 when it is an absolute symlink path (direct execution)
#   3. command -v for this script on PATH (resolves symlinks)
WRAPPER_DIR="${WRAPPER_DIR:-}"
# 1) Shell snapshot / external wrapper pre-sets these
[ -n "${WRAPPER_DIR:-}" ] && [ -d "$WRAPPER_DIR" ] && { readonly WRAPPER_DIR; LIB_DIR="${LIB_DIR:-$WRAPPER_DIR/../lib}"; REGISTRY="${REGISTRY:-/Users/macbook/Documents/me-deep-wrapper/agents/registry.json}"; PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$WRAPPER_DIR/.." 2>/dev/null && pwd)}"; }
# If we got WRAPPER_DIR from env, skip the rest
if [ -z "$WRAPPER_DIR" ]; then
    # 2) Direct execution: $0 is the script (possibly via symlink)
    if [ -L "$0" ]; then
        _target="$(readlink "$0")"
        if [ "$_target" != "${_target#/}" ]; then
            WRAPPER_DIR="$(cd "$(dirname "$_target")" && pwd)"
        else
            WRAPPER_DIR="$(cd "$(dirname "$(dirname "$0")/${_target}")" && pwd)"
        fi
        unset _target
    # 3) $0 points directly to the script
    elif [[ "$0" == */* ]] && [ -f "$0" ]; then
        WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
    # 4) $0 is a bare name on PATH - resolve via command -v
    elif command -v me-deep-wrapper-bin >/dev/null 2>&1; then
        WRAPPER_DIR="$(cd "$(dirname "$(command -v me-deep-wrapper-bin)")" && pwd)"
    elif command -v me >/dev/null 2>&1; then
        # command -v me may return a function definition ("me is a shell function from...")
        # Only accept it if the output looks like an actual filesystem path
        _me_raw="$(command -v me 2>/dev/null || true)"
        case "$_me_raw" in
            /*)  # absolute path - could be binary or symlink
                _me_path="$_me_raw"
                # Follow symlink chain to find the real file location
                while [ -n "$_me_path" ] && [ -L "$_me_path" ]; do
                    _link="$(readlink "$_me_path")"
                    if [ "$_link" != "${_link#/}" ]; then
                        _me_path="$_link"
                    else
                        _me_path="$(cd "$(dirname "$_me_path")" && pwd)/$_link"
                    fi
                    unset _link
                done
                [ -n "$_me_path" ] && WRAPPER_DIR="$(cd "$(dirname "$_me_path")" && pwd)"
                ;;
            *is\ a\ shell\ function*) ;;  # skip - it's a function, not a binary
            *)  # relative path or other
                _me_path="$(command -v me 2>/dev/null || true)"
                [ -n "$_me_path" ] && WRAPPER_DIR="$(cd "$(dirname "$_me_path")" && pwd)"
                ;;
        esac
        unset _me_path _me_raw
    # Hard fallback
    else
        WRAPPER_DIR="/Users/macbook/Documents/me-deep-wrapper/bin"
    fi
fi
LIB_DIR="$WRAPPER_DIR/../lib"
REGISTRY="${REGISTRY:-/Users/macbook/Documents/me-deep-wrapper/agents/registry.json}"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$WRAPPER_DIR/.." 2>/dev/null && pwd)}"
SOLO_PDF="/Users/macbook/Documents/DeepSeek - Solo-Platform.pdf"

log_info()  { echo -e "${BLUE}[me-deep]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[me-deep]⚠${RESET} $*" >&2; }
log_error() { echo -e "${RED}[me-deep]✗${RESET} $*" >&2; }
log_ok()    { echo -e "${GREEN}[me-deep]✓${RESET} $*"; }

# ── Agent resolution ─────────────────────────────────────────
source "$LIB_DIR/agent-patterns.sh" 2>/dev/null || true
source "$LIB_DIR/goal-executor.sh" 2>/dev/null || true
source "$LIB_DIR/hermes-tools.sh" 2>/dev/null || true
source "$LIB_DIR/model-router.sh" 2>/dev/null || true
source "$LIB_DIR/business-workflow.sh" 2>/dev/null || true


build_agent_context() {
  local agent="$1" cli="$2"
  [ -z "$agent" ] && return 0
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo -e "${BOLD}🤖 Agent Mode: ${CYAN}$agent${RESET} via ${BOLD}$cli${RESET}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  if [ "$cli" = "mekong" ]; then
    local f; f=$(find "/Users/macbook/mekong-cli/.claude/agents" -name "*${agent}*" -type f 2>/dev/null | head -1)
    [ -n "$f" ] && echo -e "  ${BLUE}Def:${RESET} $f"
  elif [ "$cli" = "claudekit" ] || [ "$cli" = "ck" ]; then
    local f; f=$(find "/Users/macbook/projects/claudekit/src/agents" -name "*${agent}*" -type f 2>/dev/null | head -1)
    [ -n "$f" ] && echo -e "  ${BLUE}Def:${RESET} $f"
  fi
  echo -e "  ${YELLOW}💡 Tip:${RESET} /agent $agent  |  /idea <goal>"
  echo ""
}

show_goal() {
  local watch_flag=""
  local _args=("$@")
  local _i=0
  while [ $_i -lt ${#_args[@]} ]; do
    case "${_args[$_i]:-}" in
      --watch) watch_flag="1"; _i=$((_i+1)) ;;
      *) _i=$((_i+1)) ;;
    esac
  done
 local last
 # Priority: active/running > in_progress > newest completed
 local _gf _t
 for _gf in /Users/macbook/Documents/me-deep-wrapper/state/goal-*.md; do
   [ -f "$_gf" ] || continue
   grep -q "^Status: \(active\|running\)$" "$_gf" 2>/dev/null || continue
   _t=$(grep "^# Goal:" "$_gf" 2>/dev/null | head -1 | sed "s/^# Goal: *//")
   case "$_t" in --help|"") continue ;; esac
   last="$_gf"
 done
 if [ -z "$last" ]; then
   last=$(grep -l '^Status: in_progress$' "/Users/macbook/Documents/me-deep-wrapper/state/goal-"*.md 2>/dev/null | sort | tail -1)
 fi
 if [ -z "$last" ]; then
   last=$(ls -t /Users/macbook/Documents/me-deep-wrapper/state/goal-*.md 2>/dev/null | head -1)
 fi
 if [ -z "$last" ]; then
    log_warn "No active goal. Use: me goal <description>"
    return 1
  fi

  _render_goal() {
    clear 2>/dev/null || true
    echo -e "${BOLD}╔══════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}║${RESET}  ${GREEN}Active Goal${RESET} — live view $(date '+%H:%M:%S')$(printf '%*s' $((34 - ${#last})) '')${RESET}"
    echo -e "${BOLD}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo ""
    cat "$last"
    echo ""
    echo -e "${BOLD}──────────────────────────────────────────────────────────────${RESET}"
    echo -e "File: ${CYAN}${last}${RESET}  |  Refresh: every 3s  |  Ctrl-C to exit"
  }

  _render_goal

  if [ "$watch_flag" = "1" ]; then
    local prev_mtime
    prev_mtime=$(stat -f '%m' "$last" 2>/dev/null || stat -c '%Y' "$last" 2>/dev/null || echo 0)
    trap 'echo ""; log_info "watch stopped"; exit 0' INT TERM
    while true; do
      sleep 3
      local cur_mtime
      cur_mtime=$(stat -f '%m' "$last" 2>/dev/null || stat -c '%Y' "$last" 2>/dev/null || echo 0)
      if [ "$cur_mtime" != "$prev_mtime" ]; then
        prev_mtime="$cur_mtime"
        _render_goal
      fi
    done
  fi
}

# ── /idea: Goal → Step plan → Agent dispatch ─────────────────
run_idea() {
# Parse --pattern <id> --chain <file> --auto --deep from args; rest = goal description
local pattern="${MEKONG_WRAPPER_PATTERN:-}"
local chain_file=""
local auto_flag=""
local deep_flag=""
local parallel_flag=""
local model_override=""
local positional=()
 local _args=("$@")
 local _i=0
 while [ $_i -lt ${#_args[@]} ]; do
 case "${_args[$_i]:-}" in
 --pattern)
 if [ $((_i+1)) -lt ${#_args[@]} ]; then
 pattern="${_args[$((_i+1))]:-}"; _i=$((_i+2))
 else _i=$((_i+1)); fi
 ;;
 --chain)
 if [ $((_i+1)) -lt ${#_args[@]} ]; then
 chain_file="${_args[$((_i+1))]:-}"; _i=$((_i+2))
 else _i=$((_i+1)); fi
 ;;
 --model)
if [ $((_i+1)) -lt ${#_args[@]} ]; then
  model_override="${_args[$((_i+1))]:-}"; _i=$((_i+2))
else
  _i=$((_i+1))
fi
;;
 --auto) auto_flag="1"; _i=$((_i+1)) ;;
--parallel) parallel_flag="1"; _i=$((_i+1)) ;;
 --deep) deep_flag="1"; _i=$((_i+1)) ;;
 --) _i=$((_i+1)); break ;;
  *) positional+=("${_args[$_i]:-}"); _i=$((_i+1)) ;;
 esac
 done
[ -n "$parallel_flag" ] && {
    MEKONG_PARALLEL="1"
    export MEKONG_PARALLEL
    log_info "parallel mode: ENABLED — all spawns will use parallel_exec"
}
# Reconstruct goal description from positional args
goal_desc=$(printf '%s ' "${positional[@]}")
goal_desc=$(echo "$goal_desc" | sed 's/ *$//')
if [ -z "$goal_desc" ]; then
log_error "Usage: me idea <description>"; return 1
fi
# pattern_label from --pattern flag/env, or auto-detect from the idea text
pattern_label="$(apply_harness_pattern "${pattern:-auto}" "$goal_desc")"
[ -z "$pattern_label" ] && pattern_label="orchestrator"

local goal_file
goal_file=$(create_idea_goal "$goal_desc" "$pattern_label") || return $?
log_ok "Idea goal saved: $goal_file"

# Per-call model override (lighter model for subagents / auto mode)
if [ -n "$model_override" ]; then
export MEKONG_MODEL="$model_override"
fi

# --auto: dispatch step 1 immediately
if [ -n "$auto_flag" ]; then
# Auto-resolve task type from pattern for model routing
local auto_task_type
auto_task_type=$(agent_to_task_type "$pattern") 2>/dev/null || auto_task_type="code-generation"
export MEKONG_TASK_TYPE="$auto_task_type"
log_info "[auto] pattern=[$pattern] → task_type=[$auto_task_type] → model=[$(route_model "$auto_task_type" 2>/dev/null | awk '{print $2}')]"
echo -e " ${CYAN}[auto]${RESET} Dispatching through legacy /idea or Mekong /goal..."
if mekong_has_command "idea"; then
  run_mekong idea run "$goal_desc — implement per blueprint"
  return $?
fi
local created goal_id
created=$(mekong goal create "$goal_desc" --json 2>/dev/null) || {
  log_error "mekong goal create failed; local idea goal remains at $goal_file"
  return 1
}
goal_id=$(printf '%s' "$created" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("id",""))' 2>/dev/null)
[ -z "$goal_id" ] && { log_error "Could not parse Mekong goal id"; return 1; }
set_goal_field "$goal_file" "MekongGoalID" "$goal_id"
mekong goal run "$goal_id" --profile none
return $?
fi

echo ""
echo " 1. me goal show → xem local idea/goal state"
echo " 2. me goal create \"$goal_desc\" → create Mekong GoalEngine task graph"
echo " 3. me goal run <goal-id> --profile none → execute/verify via Mekong /goal"
echo " 4. me step 1 → compatibility step runner"

# --chain: read sub-goals from file and queue them
if [ -n "$chain_file" ]; then
if [ ! -f "$chain_file" ]; then
log_error "Chain file not found: $chain_file"; return 1
fi
local idx=0
while IFS= read -r line; do
line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[ -z "$line" ] && continue
[[ "$line" =~ ^# ]] && continue
idx=$((idx+1))
create_goal "[chain-$idx] $line" "$pattern_label" >/dev/null 2>&1
done < "$chain_file"
echo -e " ${GREEN}[chain]${RESET} Loaded $idx sub-goals from $chain_file"
echo "Run: me step 1 (to start first sub-goal)"
fi

[ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
log_info "Idea dispatch: agent=${resolved_agent} pattern=${pattern:-auto}"
  return 0
}

mekong_has_command() {
  local needle="${1:-}"
  [ -z "$needle" ] && return 1
  COLUMNS=220 mekong --help 2>/dev/null | grep -qE "^│ ${needle}[[:space:]]"
}

# ── /command: raw CLI dispatch ──────────────────────────────
run_mekong() {
  local cmd="${1:-help}"; shift || true
  local agent
  agent=$(resolve_agent "mekong" "$cmd")
  [ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
    log_info "CLI: mekong | Command: $cmd | Agent: ${agent:-auto}"
  build_agent_context "$agent" "mekong"
  local bin; bin=$(command -v mekong 2>/dev/null || echo "/opt/homebrew/bin/mekong")
  local mekong_root="${MEKONG_ROOT:-/Users/macbook/mekong-cli}"
  export PYTHONPATH="${mekong_root}${PYTHONPATH:+:$PYTHONPATH}"
  cd "$PROJECT_ROOT"
  exec "$bin" "$cmd" "$@"
}

run_claudekit() {
  local cmd="${1:-help}"; shift || true
  local agent
  agent=$(resolve_agent "claudekit" "$cmd")
  [ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
    log_info "CLI: claudekit | Command: $cmd | Agent: ${agent:-auto}"
  build_agent_context "$agent" "claudekit"
  local bin; bin=$(which claudekit 2>/dev/null || echo "/opt/homebrew/bin/claudekit")
  cd "$PROJECT_ROOT"
  exec "$bin" "$cmd" "$@"
}


# Build MEKONG goal context for Claude session injection
build_claude_context() {
    # Build MEKONG goal context summary for injection into Claude sessions
    local goal_file
    goal_file=$(latest_goal_file 2>/dev/null) || return 0
    [ -z "$goal_file" ] && return 0

    local goal_id goal_name current_gate passed=0 total=9
    goal_id=$(basename "$goal_file" .json .md)
    goal_name=$(goal_field "$goal_file" "GoalName" 2>/dev/null || echo "$goal_id")
    current_gate=$(goal_field "$goal_file" "CurrentGate" 2>/dev/null || echo "unknown")

    # Count passed gates from JSON
    if [ -f "$GATES_DIR/${goal_id}.json" ]; then
        passed=$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));gs=d.get("gates",[]);sc=sum(1 for g in gs if isinstance(g,dict) and g.get("status")=="passed") if isinstance(gs,list) else 0;print(sc)' "$GATES_DIR/${goal_id}.json" 2>/dev/null || echo 0)
    fi

    # Evidence summary
    local evidence_summary="" ev_count=0
    if [ -d "$STATE_DIR/evidence" ]; then
        ev_count=$(find "$STATE_DIR/evidence" -name "*.json" -newer "$goal_file" 2>/dev/null | wc -l | tr -d " ")
        [ "$ev_count" -gt 0 ] && evidence_summary=" | Evidence: $ev_count artifacts"
    fi

    printf "[MEKONG Context]\nGoal: %s (%s)\nProgress: %s/%s gates passed\nCurrent Gate: %s\nActive Project: %s%s\n[End Context]\n\n" \
        "$goal_name" "$goal_id" "$passed" "$total" "$current_gate" "$(basename "$PROJECT_ROOT")" "$evidence_summary"
}
run_claude() {
  local model="${MEKONG_MODEL:-${MEKONG_MODEL_ROUTED:-claude-sonnet-4-6}}"

  # If Hermes is available, use it with model routing
  if [ "${HERMES_ENABLED:-auto}" != "disable" ] && hermes_available 2>/dev/null; then
    local task_type="${MEKONG_TASK_TYPE:-code-generation}"
    local route
    route=$(route_model "$task_type" 2>/dev/null) || route="anthropic claude-sonnet-4-6 3 medium"
    local _r="$route"
    local provider="${_r%% *}"
    _r="${_r#* }"
    local hmodel="${_r%% *}"
    _r="${_r#* }"
    local priority="${_r%% *}"
    log_info "CLI: hermes[$priority] | $task_type → $provider:$hmodel"
    cd "$PROJECT_ROOT"
    # Pass through extra args (--agent, --allowedTools, etc.) plus hermes model
       local ctx=""
    ctx=$(build_claude_context 2>/dev/null) || ctx=""
    if [ -n "$ctx" ]; then
        exec "$HERMES_BIN" -m "${provider}:${hmodel}" --append-system-prompt "$ctx" "$@"
    else
        exec "$HERMES_BIN" -m "${provider}:${hmodel}" "$@"
    fi
  fi

  # Fallback: direct claude CLI
  log_info "CLI: claude | Model: $model"
  cd "$PROJECT_ROOT"
     local ctx=""
    ctx=$(build_claude_context 2>/dev/null) || ctx=""
    if [ -n "$ctx" ]; then
        exec claude --model "$model" --append-system-prompt "$ctx" "$@"
    else
        exec claude --model "$model" "$@"
    fi
}

# ── agents subcommand ───────────────────────────────────────
cmd_agents() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
  list)
    echo -e "${BOLD}Available Agents${RESET}"
    echo ""
    local n_mekong=0 n_ck=0
    echo -e "${CYAN}── Mekong-CLI Agents${RESET}"
    if command -v registry_list >/dev/null 2>&1; then
      while IFS=$'	' read -r aid cmds path; do
        [ -z "$aid" ] && continue
        printf "  ${GREEN}%-25s${RESET} %s\n" "$aid" "[$cmds]"
        n_mekong=$((n_mekong+1))
      done < <(registry_list "mekong")
    else
      for a in "${MEKONG_AGENTS[@]}"; do
        [ -z "$a" ] && continue
        printf "  ${GREEN}%-25s${RESET} %s\n" "$a" "[registry.json]"
        n_mekong=$((n_mekong+1))
      done
    fi
    echo ""
    echo -e "${CYAN}── ClaudeKit Agents${RESET}"
    if command -v registry_list >/dev/null 2>&1; then
      while IFS=$'	' read -r aid cmds path; do
        [ -z "$aid" ] && continue
        printf "  ${GREEN}%-25s${RESET} %s\n" "$aid" "[$cmds]"
        n_ck=$((n_ck+1))
      done < <(registry_list "claudekit")
    else
      for a in "${CLAUDEKIT_AGENTS[@]}"; do
        [ -z "$a" ] && continue
        printf "  ${GREEN}%-25s${RESET} %s\n" "$a" "[registry.json]"
        n_ck=$((n_ck+1))
      done
    fi
    echo ""
    echo -e "Total: Mekong ${BOLD}$n_mekong${RESET} · ClaudeKit ${BOLD}$n_ck${RESET} · source: ${YELLOW}agents/registry.json${RESET}"
    ;;
  show)
    local agent="${1:-}"
    [ -z "$agent" ] && { log_error "Agent id required"; exit 1; }
    echo "Agent: $agent"
    echo "---"
    local meta=""
    if command -v _registry_get_meta >/dev/null 2>&1; then
      meta=$(_registry_get_meta "$agent" "mekong" 2>/dev/null || true)
      [ -z "$meta" ] && meta=$(_registry_get_meta "$agent" "claudekit" 2>/dev/null || true)
    else
      meta=$(get_agent_meta "$agent" "mekong" 2>/dev/null || true)
      [ -z "$meta" ] && meta=$(get_agent_meta "$agent" "claudekit" 2>/dev/null || true)
    fi
    [ -n "$meta" ] && echo "$meta" || echo "Not found in registry"
    ;;
  commands)
    local q="${1:-}"
    echo -e "${BOLD}Command → Agent map${RESET}"
    echo ""
    if command -v list_commands >/dev/null 2>&1; then
      if [ -n "$q" ]; then list_commands "$q"; else list_commands; fi
    else
      echo "(command catalog not available — requires agent-patterns.sh >= 2026-06-01)"
    fi
    echo ""
    echo "Tip: me agents commands [keyword]  → filter;  me agents commands → all"
    ;;
  routes|route-map)
    local q="${1:-}"
    echo -e "${BOLD}Command → Agent → Department → Gate map${RESET}"
    echo ""
    if command -v list_command_routes >/dev/null 2>&1; then
      list_command_routes "$q"
    else
      echo "(command route catalog not available — requires agent-patterns.sh >= 2026-06-02)"
    fi
    echo ""
    echo "Tip: me agents routes [keyword]  → filter command taxonomy"
    ;;
  help)
    echo "Usage: me agents <sub> [args]"
    echo "  agents list              List registered agents from registry.json"
    echo "  agents show <id>         Show agent metadata (path + domain)"
    echo "  agents commands [q]      Show command→agent mapping (filter by keyword)"
    echo "  agents routes [q]        Show command→agent→department→gate mapping"
    echo "  agents help              This help"
    ;;
  *)
    log_error "Unknown: me agents $sub"; exit 1 ;;
  esac
}

# ── model subcommand — Model Router visibility ─────────────────────────
cmd_model() {
local sub="${1:-report}"; shift || true
case "$sub" in
report|matrix|costs)
model_report
;;
route)
local task_type="${1:-code-generation}"
local route
route=$(route_model "$task_type" 2>/dev/null) || route="anthropic claude-sonnet-4-6 3 medium"
echo "$route"
;;
*)
echo "Usage: me model <sub>"
echo " model report   Show cost/quality matrix"
echo " model route    Route a specific task type"
;;
esac
}
# ── project subcommand ─────────────────────────────────────
cmd_project() {
  local scope="${1:-}"; shift || true
  [ -z "$scope" ] && { log_error "Scope required: me project <scope> <cmd>"; exit 1; }
  local cmd="${1:-help}"; shift || true
  local full=""
  case "$scope" in
    audit)   full="mekong audit $cmd $*" ;;
    bridge)  full="mekong bridge $cmd $*" ;;
    cook)    full="mekong cook $cmd $*" ;;
    repo)    full="mekong $cmd $*" ;;
    crm)     full="mekong $cmd $*" ;;
    finance) full="mekong finance $cmd $*" ;;
    mekong)  full="mekong $cmd $*" ;;
    ck)      full="claudekit $cmd $*" ;;
    lint)    full="claudekit lint-commands $cmd $*" ;;
    *)       log_error "Unknown scope: $scope"; exit 1 ;;
  esac
  log_info "Project scope: $scope → $full"
  cd "$PROJECT_ROOT"
  eval "$full"
}

# ── chain subcommand ───────────────────────────────────────
cmd_chain() {
  local chain="$*"
  [ -z "$chain" ] && { log_error "Usage: me chain '<cmd1> && <cmd2>'"; exit 1; }
  echo -e "${BOLD}⛓️  Command Chain${RESET}"
  echo ""
  local IFS='&&'; local cmds=($chain)
  for c in "${cmds[@]}"; do
    c=$(echo "$c" | sed 's/^ *//;s/ *$//')
    [ -z "$c" ] && continue
    echo -e "  ${GREEN}▶${RESET} $c"
  done
  echo ""
  for c in "${cmds[@]}"; do
    c=$(echo "$c" | sed 's/^ *//;s/ *$//')
    [ -z "$c" ] && continue
    echo -e "${CYAN}Executing:${RESET} $c"
    cd "$PROJECT_ROOT"
    eval "$c"
    local s=$?
    if [ $s -ne 0 ]; then log_error "Chain failed: $c (exit $s)"; exit $s; fi
    echo ""
  done
  log_ok "Chain complete"
}

solo_loop_pass() {
  local f="${1:-}"
  [ -z "$f" ] && f=$(latest_goal_file 2>/dev/null || true)
  [ -z "$f" ] && { log_error "No Solo Company goal. Use: me solo start <idea>"; return 1; }
  echo "Coordinator pass:"
  if [ -n "${SOLO_REVENUE_FILE:-}" ]; then
    sync_revenue_from_file "$f" "$SOLO_REVENUE_FILE" "solo:file" || return $?
    echo "  RevenueSync: $SOLO_REVENUE_FILE"
  elif [ -n "${POLAR_MRR_FILE:-}" ]; then
    sync_revenue_from_file "$f" "$POLAR_MRR_FILE" "polar:file" || return $?
    echo "  RevenueSync: $POLAR_MRR_FILE"
  fi
  local route dept reason owner gate path
  route=$(next_department_for_goal "$f")
  dept=$(printf '%s\n' "$route" | sed -n 's/^Department: //p' | head -1)
  reason=$(printf '%s\n' "$route" | sed -n 's/^Reason: //p' | head -1)
  owner=$(registry_department_owner "$dept" 2>/dev/null || true)
  gate=$(registry_department_gate "$dept" 2>/dev/null || true)
  if [ -z "$dept" ] || [ -z "$owner" ] || [ -z "$gate" ]; then
    log_error "Coordinator could not resolve next department"
    return 1
  fi
  path=$(write_gate_artifact "$gate" "$owner" "ready" "$reason" "$dept") || return $?
  record_department_run "$f" "$dept" "$owner" "$gate" "ready" "$path" "$reason" || return $?
  echo "  RanDepartment: $dept"
  echo "  Owner:         $owner"
  echo "  GateArtifact:  $gate"
  echo "  Artifact:      $path"
  echo ""
  echo "Gate verification:"
  verify_gate_artifacts "$f" | sed 's/^/  /' || return $?
  echo ""
}

solo_daemon_paths() {
  local base="/Users/macbook/Documents/me-deep-wrapper/state/loops"
  mkdir -p "$base"
  echo "$base"
}

solo_loop_status_write() {
  local status_file="${1:-}"
  local state="${2:-unknown}"
  local pass="${3:-0}"
  local failures="${4:-0}"
  local max_failures="${5:-0}"
  local goal="${6:-}"
  local message="${7:-}"
  [ -z "$status_file" ] && return 1
  python3 - "$status_file" "$state" "$pass" "$failures" "$max_failures" "$goal" "$message" <<'PY'
import json, os, sys
from datetime import datetime, timezone
path, state, pass_no, failures, max_failures, goal, message = sys.argv[1:8]
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
else:
    data = {"events": []}
event = {
    "at": now,
    "state": state,
    "pass": int(pass_no),
    "consecutive_failures": int(failures),
    "max_failures": int(max_failures),
    "goal": goal,
    "message": message,
}
data.update(event)
data.setdefault("events", []).append(event)
data["events"] = data["events"][-50:]
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
}

solo_launchd_plist() {
  local interval="${1:-300}"
  local max_failures="${2:-3}"
  local retries="${3:-0}"
  local label="${4:-com.mekongmind.solo-loop}"
  local stdout_log="${5:-/Users/macbook/Documents/me-deep-wrapper/state/loops/launchd.out.log}"
  local stderr_log="${6:-/Users/macbook/Documents/me-deep-wrapper/state/loops/launchd.err.log}"
  local me_bin="$WRAPPER_DIR/me"
  python3 - "$label" "$me_bin" "$PROJECT_ROOT" "$interval" "$max_failures" "$retries" "$stdout_log" "$stderr_log" <<'PY'
import plistlib, sys
label, me_bin, project_root, interval, max_failures, retries, stdout_log, stderr_log = sys.argv[1:9]
plist = {
    "Label": label,
    "ProgramArguments": [
        me_bin,
        "solo",
        "daemon",
        "run",
        "--forever",
        "--interval",
        str(interval),
        "--max-failures",
        str(max_failures),
        "--retries",
        str(retries),
    ],
    "WorkingDirectory": project_root,
    "EnvironmentVariables": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "PROJECT_ROOT": project_root,
    },
    "RunAtLoad": False,
    "KeepAlive": False,
    "StandardOutPath": stdout_log,
    "StandardErrorPath": stderr_log,
}
sys.stdout.buffer.write(plistlib.dumps(plist, fmt=plistlib.FMT_XML, sort_keys=False))
PY
}

# ── solo subcommand: Solo Company orchestration ─────────────
cmd_solo() {
  local action="${1:-status}"; shift || true
  case "$action" in
    status)
      echo -e "${BOLD}🏢 Solo Company Status${RESET}"
      echo "  PDF Spec: $SOLO_PDF"
      [ -f "$SOLO_PDF" ] && echo -e "  ${GREEN}✓${RESET} Solo-Platform.pdf loaded" || echo -e "  ${RED}✗${RESET} PDF missing"
      echo "  Agents:   $(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("%d unified agents" % len(d.get("unified_agents", [])))' "$REGISTRY" 2>/dev/null || echo "?")"
      echo "  CLIs:     mekong ✓ | claudekit ✓ | claude ✓"
      local f
      f=$(latest_goal_file 2>/dev/null || true)
      if [ -n "$f" ]; then
        local current_mrr
        current_mrr=$(goal_field "$f" "CurrentMRR")
        [ -z "$current_mrr" ] && current_mrr=0
        local target_mrr
        target_mrr=$(goal_field "$f" "RevenueTarget")
        [ -z "$target_mrr" ] && target_mrr=1000000
        echo "  Goal:     $(goal_field "$f" "Goal")"
        echo "  Mode:     $(goal_field "$f" "SoloCompanyMode")"
        echo "  DNA:      $(goal_field "$f" "PlatformDNA")"
        echo "  Target:   \$$target_mrr"
        echo "  MRR:      \$$current_mrr"
        echo "  Gate:     $(goal_field "$f" "CurrentGate")"
        echo "  Loop:     $(goal_field "$f" "FactoryLoop")"
      fi
      ;;
    products|portfolio)
      local product_action="${1:-list}"
      shift || true
      local scan_root="${MEKONG_PRODUCT_SCAN_ROOT:-/Users/macbook}"
      local inventory_path=""
      while [ $# -gt 0 ]; do
        case "${1:-}" in
          --root) scan_root="${2:-$scan_root}"; shift 2 || true ;;
          --write|--out) inventory_path="${2:-}"; shift 2 || true ;;
          *) break ;;
        esac
      done
      case "$product_action" in
        scan|discover)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          echo -e "${BOLD}🧭 Mekongmind Local Product Inventory${RESET}"
          local written
          written=$(scan_local_products "$scan_root" "$inventory_path") || exit $?
          log_ok "Product inventory written: $written"
          product_inventory_summary "$written"
          ;;
        list|show|status)
          product_inventory_summary "$inventory_path" || exit $?
          ;;
        queue|enqueue)
          local queue_path="${PRODUCT_SELF_SELLING_QUEUE_FILE:-}"
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          [ -z "$queue_path" ] && queue_path="$(product_self_selling_queue_file)"
          echo -e "${BOLD}📦 Mekongmind Product Self-Selling Queue${RESET}"
          local queued
          queued=$(build_product_self_selling_queue "$inventory_path" "$queue_path") || exit $?
          log_ok "Product self-selling queue written: $queued"
          product_self_selling_queue_summary "$queued"
          ;;
        audit|verify-queue)
          local audit_mode="coverage"
          while [ $# -gt 0 ]; do
            case "${1:-}" in
              --strict) audit_mode="strict"; shift || true ;;
              --self-selling|--completion) audit_mode="self-selling"; shift || true ;;
              *) break ;;
            esac
          done
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          echo -e "${BOLD}🔎 Mekongmind Product Queue Coverage${RESET}"
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "$audit_mode" || exit $?
          ;;
        loop|run|pass)
          local loop_once=""
          if [ "${1:-}" = "--once" ]; then
            loop_once="1"
            shift || true
          fi
          [ -z "$loop_once" ] && { log_error "Usage: me solo products loop --once [product-query]"; exit 1; }
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local query
          query=$(next_product_queue_query "${1:-}") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}🔁 Mekongmind Product Self-Selling Pass${RESET}"
          echo "  ProductQuery: $query"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" || exit $?
          echo ""
          select_product_for_goal "$query" || exit $?
          echo ""
          validate_department_artifact "ceo-command" || exit $?
          echo ""
          generate_offer_artifact_for_goal || exit $?
          echo ""
          validate_department_artifact "market-intelligence" || exit $?
          validate_department_artifact "product-strategy" || exit $?
          local snap_product_name snap_product_path snap_goal_id
          snap_product_name=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("product_name",""))' "$PROJECT_ROOT/state/evidence/company-blueprint.json" 2>/dev/null || true)
          snap_product_path=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("product_path",""))' "$PROJECT_ROOT/state/evidence/company-blueprint.json" 2>/dev/null || true)
          snap_goal_id=$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)
          snapshot_product_artifacts "$snap_product_name" "$snap_product_path" "$snap_goal_id" >/dev/null 2>&1 || true
          echo ""
          echo -e "${CYAN}Next strict bottleneck${RESET}"
          goal_readiness_matrix "$(latest_goal_file)" "strict" | sed 's/^/  /'
          ;;
        next|next-action|todo)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local query
          query=$(next_product_queue_query "${1:-}") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}🧭 Mekongmind Product Next Action${RESET}"
          echo "  ProductQuery: $query"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
          echo ""
          product_next_action "$query" || exit $?
          ;;
        work-packet|growth-sales-packet|outreach-packet)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local query
          query=$(next_product_queue_query "${1:-}") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}📨 Mekongmind Product Growth/Sales Work Packet${RESET}"
          echo "  ProductQuery: $query"
          echo "  Guard: draft only; no outreach send, no Polar mutation, no revenue claim"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
          echo ""
          select_product_for_goal "$query" || exit $?
          echo ""
          validate_department_artifact "ceo-command" || exit $?
          echo ""
          generate_offer_artifact_for_goal || exit $?
          echo ""
          validate_department_artifact "market-intelligence" || exit $?
          validate_department_artifact "product-strategy" || exit $?
          echo ""
          local packet_product_name packet_product_path packet_goal_id
          packet_product_name=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("product_name",""))' "$PROJECT_ROOT/state/evidence/company-blueprint.json" 2>/dev/null || true)
          packet_product_path=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("product_path",""))' "$PROJECT_ROOT/state/evidence/company-blueprint.json" 2>/dev/null || true)
          packet_goal_id=$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)
          snapshot_product_artifacts "$packet_product_name" "$packet_product_path" "$packet_goal_id" >/dev/null 2>&1 || true
          generate_product_growth_sales_work_packet "$packet_goal_id" || exit $?
          ;;
        campaign-proof|campaign-evidence|outreach-proof)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local raw_query="${1:-}"
          local outreach_log_file=""
          local write_shared=""
          [ -n "$raw_query" ] && shift || true
          while [ $# -gt 0 ]; do
            case "${1:-}" in
              --log|--outreach-log) outreach_log_file="${2:-}"; shift 2 || true ;;
              --write-shared) write_shared="--write-shared"; shift || true ;;
              *) break ;;
            esac
          done
          [ -n "$outreach_log_file" ] || { log_error "Usage: me solo products campaign-proof <product> --log <outreach-log.json> [--write-shared]"; exit 1; }
          local query
          query=$(next_product_queue_query "$raw_query") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}📣 Mekongmind Product Campaign Evidence${RESET}"
          echo "  ProductQuery: $query"
          echo "  OutreachLog:  $outreach_log_file"
          echo "  Guard: ingest/validate real outreach log only; no email send, no Polar mutation, no revenue claim"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
          echo ""
          generate_product_campaign_evidence_from_log "$query" "$outreach_log_file" "$write_shared" "$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)" || exit $?
          ;;
        revenue-proof|revenue-evidence|polar-proof)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local raw_query="${1:-}"
          local polar_file=""
          local write_shared=""
          local sync_goal=""
          [ -n "$raw_query" ] && shift || true
          while [ $# -gt 0 ]; do
            case "${1:-}" in
              --polar|--polar-file|--provider-file) polar_file="${2:-}"; shift 2 || true ;;
