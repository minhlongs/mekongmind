            esac
          done
          [ -n "$polar_file" ] || { log_error "Usage: me solo products revenue-proof <product> --polar <polar-evidence.json> [--write-shared] [--sync-goal]"; exit 1; }
          local query
          query=$(next_product_queue_query "$raw_query") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}💵 Mekongmind Product Polar Revenue Evidence${RESET}"
          echo "  ProductQuery: $query"
          echo "  PolarEvidence: $polar_file"
          echo "  Guard: ingest/validate Polar evidence only; no provider mutation; no fulfillment claim"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
