          generate_product_revenue_evidence_from_polar "$query" "$polar_file" "$write_shared" "$sync_goal" "$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)" || exit $?
          ;;
        fulfillment-proof|fulfillment-evidence|customer-proof)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local raw_query="${1:-}"
          local fulfillment_file=""
          local write_shared=""
          [ -n "$raw_query" ] && shift || true
          while [ $# -gt 0 ]; do
            case "${1:-}" in
              --artifact|--proof|--fulfillment|--file) fulfillment_file="${2:-}"; shift 2 || true ;;
              --write-shared) write_shared="--write-shared"; shift || true ;;
              *) break ;;
            esac
          done
          [ -n "$fulfillment_file" ] || { log_error "Usage: me solo products fulfillment-proof <product> --artifact <fulfillment-stable.json> [--write-shared]"; exit 1; }
          local query
          query=$(next_product_queue_query "$raw_query") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}🤝 Mekongmind Product Fulfillment Evidence${RESET}"
          echo "  ProductQuery: $query"
          echo "  FulfillmentArtifact: $fulfillment_file"
          echo "  Guard: ingest/validate customer outcome evidence only; no Polar mutation; no clone/self-selling claim"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
          echo ""
          generate_product_fulfillment_evidence_from_artifact "$query" "$fulfillment_file" "$write_shared" "$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)" || exit $?
          ;;
        clone-proof|clone-memory-proof|scale-proof)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local raw_query="${1:-}"
          local clone_file=""
          local write_shared=""
          [ -n "$raw_query" ] && shift || true
          while [ $# -gt 0 ]; do
            case "${1:-}" in
              --artifact|--proof|--clone|--file) clone_file="${2:-}"; shift 2 || true ;;
              --write-shared) write_shared="--write-shared"; shift || true ;;
              *) break ;;
            esac
          done
          [ -n "$clone_file" ] || { log_error "Usage: me solo products clone-proof <product> --artifact <scale-ready.json> [--write-shared]"; exit 1; }
          local query
          query=$(next_product_queue_query "$raw_query") || { log_error "No queued product found"; exit 1; }
          echo -e "${BOLD}🧠 Mekongmind Product Clone Memory Evidence${RESET}"
          echo "  ProductQuery: $query"
          echo "  CloneArtifact: $clone_file"
          echo "  Guard: ingest/validate clone memory only; self-selling requires first \$1M MRR"
          echo ""
          verify_product_self_selling_queue "$inventory_path" "$(product_self_selling_queue_file)" "strict" || exit $?
          echo ""
          generate_product_clone_evidence_from_artifact "$query" "$clone_file" "$write_shared" "$(goal_id_from_file "$(latest_goal_file)" 2>/dev/null || true)" || exit $?
          ;;
        release-packet|mvp-packet|release-readiness)
          [ -z "$inventory_path" ] && inventory_path="$(product_inventory_file)"
          local query
          query=$(next_product_queue_query "${1:-}") || { log_error "No queued product found"; exit 1; }
