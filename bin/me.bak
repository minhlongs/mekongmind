#!/bin/bash
# ── me-deep-wrapper v1.0.0 — CEO Solo Company Orchestrator ─
# Wraps: mekong-cli + claudekit + claude
# Paradigm: /command + /idea (Harness Engineering)
# ─────────────────────────────────────────────────────────────
# me-deep-wrapper v1.0.0 — CEO Solo Company Orchestrator
# Wraps: mekong-cli + claudekit + claude
# Paradigm: /command + /idea (Harness Engineering)
# Source: walkinglabs/awesome-harness-engineering + Solo-Platform
# ─────────────────────────────────────────────────────────────
set -uo pipefail
set +u  # nounset breaks array access in run_idea
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
WRAPPER_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIB_DIR="$WRAPPER_DIR/../lib"
REGISTRY="/Users/macbook/Documents/me-deep-wrapper/agents/registry.json"
PROJECT_ROOT="/Users/macbook"
SOLO_PDF="/Users/macbook/Documents/DeepSeek - Solo-Platform.pdf"

log_info()  { echo -e "${BLUE}[me-deep]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[me-deep]⚠${RESET} $*" >&2; }
log_error() { echo -e "${RED}[me-deep]✗${RESET} $*" >&2; }
log_ok()    { echo -e "${GREEN}[me-deep]✓${RESET} $*"; }

# ── Agent resolution ─────────────────────────────────────────
source "$LIB_DIR/agent-patterns.sh" 2>/dev/null || true
source "$LIB_DIR/goal-executor.sh" 2>/dev/null || true


build_agent_context() {
  local agent="$1" cli="$2"
  [ -z "$agent" ] && return 0
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo -e "${BOLD}🤖 Agent Mode: ${CYAN}$agent${RESET} via ${BOLD}$cli${RESET}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  if [ "$cli" = "mekong" ]; then
    local f; f=$(find "/Users/macbook/mekong-cli/.claude/agents" -name "*${agent}*" -type f 2>/dev/null | head -1)
    [ -n "$f" ] && echo -e "  ${BLUE}Def:${RESET} $f"
  elif [ "$cli" = "claudekit" ] || [ "$cli" = "ck" ]; then
    local f; f=$(find "/Users/macbook/projects/claudekit/src/agents" -name "*${agent}*" -type f 2>/dev/null | head -1)
    [ -n "$f" ] && echo -e "  ${BLUE}Def:${RESET} $f"
  fi
  echo -e "  ${YELLOW}💡 Tip:${RESET} /agent $agent  |  /idea <goal>"
  echo ""
}

# ── Goals (Harness Engineering) ─────────────────────────────
create_goal() {
  local goal_desc="${1:-}"
 local pattern_label="${2:-}"
  local stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  local f="/Users/macbook/Documents/me-deep-wrapper/state/goal-${stamp}.md"
     echo "[DBG] goal=[$goal_desc] pattern_label=[$pattern_label]" >&2
    cat > "$f" << EOF
# Goal: $goal_desc
Created: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
Pattern: ${pattern_label}
Status: active
Steps: []
EOF
  log_ok "Goal saved: $f"
}

show_goal() {
  local last
  last=$(ls -t /Users/macbook/Documents/me-deep-wrapper/state/goal-*.md 2>/dev/null | head -1)
  if [ -n "$last" ]; then
    echo -e "${BOLD}Active Goal:${RESET}"
    head -10 "$last"
  else
    log_warn "No active goal. Use: me goal <description>"
  fi
}

# ── /idea: Goal → Step plan → Agent dispatch ─────────────────
run_idea() {
# Parse --pattern <id> --chain <file> --auto --deep from args; rest = goal description
local pattern="${MEKONG_WRAPPER_PATTERN:-}"
local chain_file=""
local auto_flag=""
local deep_flag=""
local model_override=""
local positional=()
 local _args=("$@")
 local _i=0
 while [ $_i -lt ${#_args[@]} ]; do
 case "${_args[$_i]:-}" in
 --pattern)
 if [ $((_i+1)) -lt ${#_args[@]} ]; then
 pattern="${_args[$((_i+1))]:-}"; _i=$((_i+2))
 else _i=$((_i+1)); fi
 ;;
 --chain)
 if [ $((_i+1)) -lt ${#_args[@]} ]; then
 chain_file="${_args[$((_i+1))]:-}"; _i=$((_i+2))
 else _i=$((_i+1)); fi
 ;;
 --model)
if [ $((_i+1)) -lt ${#_args[@]} ]; then
  model_override="${_args[$((_i+1))]:-}"; _i=$((_i+2))
else
  _i=$((_i+1))
fi
;;
 --auto) auto_flag="1"; _i=$((_i+1)) ;;
 --deep) deep_flag="1"; _i=$((_i+1)) ;;
 --) _i=$((_i+1)); break ;;
 *) positional+=("${_args[$_i]:-}"); _i=$((_i+1)) ;;
 esac
 done
# Reconstruct goal description from positional args
goal_desc=$(printf '%s ' "${positional[@]}")
goal_desc=$(echo "$goal_desc" | sed 's/ *$//')
# pattern_label from --pattern flag or env fallback
pattern_label="${pattern:-orchestrator}"

create_goal "$goal_desc" "$pattern_label"

# Per-call model override (lighter model for subagents / auto mode)
if [ -n "$model_override" ]; then
export MEKONG_MODEL="$model_override"
fi

# --auto: dispatch step 1 immediately
if [ -n "$auto_flag" ]; then
echo -e " ${CYAN}[auto]${RESET} Dispatching step 1..."
run_step 1
return $?
fi

echo ""
echo " 1. me goal show → xem goal hiện tại"
echo " 2. me step 1 → chạy Step 1"
echo " 3. me goal show → xem goal hiện tại"

# --chain: read sub-goals from file and queue them
if [ -n "$chain_file" ]; then
if [ ! -f "$chain_file" ]; then
log_error "Chain file not found: $chain_file"; return 1
fi
local idx=0
while IFS= read -r line; do
line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[ -z "$line" ] && continue
[[ "$line" =~ ^# ]] && continue
idx=$((idx+1))
create_goal "[chain-$idx] $line" "$pattern_label" >/dev/null 2>&1
done < "$chain_file"
echo -e " ${GREEN}[chain]${RESET} Loaded $idx sub-goals from $chain_file"
echo "Run: me step 1 (to start first sub-goal)"
fi

[ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
log_info "Idea dispatch: agent=${resolved_agent} pattern=${pattern:-auto}"
  return 0
}

# ── /command: raw CLI dispatch ──────────────────────────────
run_mekong() {
  local cmd="${1:-help}"; shift || true
  local agent
  agent=$(resolve_agent "mekong" "$cmd")
  [ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
    log_info "CLI: mekong | Command: $cmd | Agent: ${agent:-auto}"
  build_agent_context "$agent" "mekong"
  local bin; bin=$(command -v mekong 2>/dev/null || echo "/opt/homebrew/bin/mekong")
  cd "$PROJECT_ROOT"
  exec "$bin" "$cmd" "$@"
}

run_claudekit() {
  local cmd="${1:-help}"; shift || true
  local agent
  agent=$(resolve_agent "claudekit" "$cmd")
  [ "${MEKONG_WRAPPER_VERBOSE:-0}" = "1" ] && \
    log_info "CLI: claudekit | Command: $cmd | Agent: ${agent:-auto}"
  build_agent_context "$agent" "claudekit"
  local bin; bin=$(which claudekit 2>/dev/null || echo "/opt/homebrew/bin/claudekit")
  cd "$PROJECT_ROOT"
  exec "$bin" "$cmd" "$@"
}

run_claude() {
  local model="${MEKONG_MODEL:-claude-sonnet-4-20250514}"
  shift || true
  log_info "CLI: claude | Model: $model"
  cd "$PROJECT_ROOT"
  exec claude --model "$model" "$@"
}

# ── agents subcommand ───────────────────────────────────────
cmd_agents() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      echo -e "${BOLD}Available Agents${RESET}"
      echo ""
      echo -e "${CYAN}── Mekong-CLI Agents (15)${RESET}"
      for a in audit-expert finance-agent fullstack-developer cook-agent devops-agent docs-manager git-agent infrastructure-agent growth-agent planner revenue-agent sales-agent sync-agent design-agent creative-agent; do
        printf "  %-22s" "$a"
        local meta; meta=$(get_agent_meta "$a" 2>/dev/null || echo "")
        [ -n "$meta" ] && echo -e " ${BLUE}→ ${meta%%|*}${RESET}" || echo ""
      done
      echo ""
      echo -e "${CYAN}── ClaudeKit Agents (14)${RESET}"
      for a in code-quality code-reviewer code-review-expert research-expert database frontend backend devops typescript testing e2e git documentation triage-expert; do
        printf "  %-22s" "$a"
        local meta; meta=$(get_agent_meta "$a" 2>/dev/null || echo "")
        [ -n "$meta" ] && echo -e " ${BLUE}→ ${meta%%|*}${RESET}" || echo ""
      done
      ;;
    suggest)
      local cmd="${1:-}"; [ -z "$cmd" ] && { log_error "Usage: me agents suggest <command>"; exit 1; }
      echo -e "${BOLD}Suggestion for: ${CYAN}$cmd${RESET}"
      local ag
      ag=$(resolve_agent "mekong" "$cmd"); [ -n "$ag" ] && echo -e "  Mekong-CLI: ${GREEN}$ag${RESET}" || echo -e "  Mekong-CLI: ${YELLOW}general${RESET}"
      ag=$(resolve_agent "claudekit" "$cmd"); [ -n "$ag" ] && echo -e "  ClaudeKit:  ${GREEN}$ag${RESET}" || echo -e "  ClaudeKit:  ${YELLOW}general${RESET}"
      ;;
    *) log_error "Unknown: me agents $sub"; exit 1 ;;
  esac
}

# ── project subcommand ─────────────────────────────────────
cmd_project() {
  local scope="${1:-}"; shift || true
  [ -z "$scope" ] && { log_error "Scope required: me project <scope> <cmd>"; exit 1; }
  local cmd="${1:-help}"; shift || true
  local full=""
  case "$scope" in
    audit)   full="mekong audit $cmd $*" ;;
    bridge)  full="mekong bridge $cmd $*" ;;
    cook)    full="mekong cook $cmd $*" ;;
    repo)    full="mekong $cmd $*" ;;
    crm)     full="mekong $cmd $*" ;;
    finance) full="mekong finance $cmd $*" ;;
    mekong)  full="mekong $cmd $*" ;;
    ck)      full="claudekit $cmd $*" ;;
    lint)    full="claudekit lint-commands $cmd $*" ;;
    *)       log_error "Unknown scope: $scope"; exit 1 ;;
  esac
  log_info "Project scope: $scope → $full"
  cd "$PROJECT_ROOT"
  eval "$full"
}

# ── chain subcommand ───────────────────────────────────────
cmd_chain() {
  local chain="$*"
  [ -z "$chain" ] && { log_error "Usage: me chain '<cmd1> && <cmd2>'"; exit 1; }
  echo -e "${BOLD}⛓️  Command Chain${RESET}"
  echo ""
  local IFS='&&'; local cmds=($chain)
  for c in "${cmds[@]}"; do
    c=$(echo "$c" | sed 's/^ *//;s/ *$//')
    [ -z "$c" ] && continue
    echo -e "  ${GREEN}▶${RESET} $c"
  done
  echo ""
  for c in "${cmds[@]}"; do
    c=$(echo "$c" | sed 's/^ *//;s/ *$//')
    [ -z "$c" ] && continue
    echo -e "${CYAN}Executing:${RESET} $c"
    cd "$PROJECT_ROOT"
    eval "$c"
    local s=$?
    if [ $s -ne 0 ]; then log_error "Chain failed: $c (exit $s)"; exit $s; fi
    echo ""
  done
  log_ok "Chain complete"
}

# ── solo subcommand: Solo Company orchestration ─────────────
cmd_solo() {
  local action="${1:-status}"; shift || true
  case "$action" in
    status)
      echo -e "${BOLD}🏢 Solo Company Status${RESET}"
      echo "  PDF Spec: $SOLO_PDF"
      [ -f "$SOLO_PDF" ] && echo -e "  ${GREEN}✓${RESET} Solo-Platform.pdf loaded" || echo -e "  ${RED}✗${RESET} PDF missing"
      echo "  Agents:   $(cat "$REGISTRY" 2>/dev/null | python3 -c 'import json,sys;d=json.load(sys.stdin);print(len(d.get("mekong_agents",[]))+len(d.get("claudekit_agents",[])))' 2>/dev/null || echo "?")"
      echo "  CLIs:     mekong ✓ | claudekit ✓ | claude ✓"
      ;;
    pdf)
      [ -f "$SOLO_PDF" ] && log_ok "PDF spec ready at $SOLO_PDF" || log_error "PDF not found"
      ;;
    *)
      log_error "Unknown: me solo $action"
      echo "Usage: me solo [status|pdf]"
      exit 1
      ;;
  esac
}

# run_step N: execute Nth step of latest goal
# Safety: if goal-helper functions are missing, reload goal-executor.
type latest_goal_file >/dev/null 2>&1 || { source "$LIB_DIR/goal-executor.sh" 2>&1 >/dev/null || true; }
run_step() {
local n="${1:-}"
[ -z "$n" ] && { log_error "Usage: me step <N>"; exit 1; }
local f; f=$(latest_goal_file)
[ -z "$f" ] && { log_error "Chưa có goal nào. Tạo bằng: me idea <mô tả>"; exit 1; }
if step_done "$f" "$n"; then
log_info "Step $n đã hoàn thành (bỏ qua)."; return 0
fi
local pattern; pattern=$(goal_field "$f" "Pattern")
local goal_desc; goal_desc=$(goal_field "$f" "Goal")
local agent; agent=$(resolve_agent "step" "step $n of goal: $goal_desc")
# Fallback routing: try pattern label as agent id, then orchestrator
if [ -z "$agent" ] && [ -n "$pattern" ]; then
  if grep -q "\"id\": *\"${pattern}\"" "$REGISTRY" 2>/dev/null; then
    agent="$pattern"
  elif [ -n "$(grep -A5 '"id":' "$REGISTRY" 2>/dev/null | grep -i "\"domain\".*${pattern}\"")" ]; then
    agent="$pattern"
  fi
fi
[ -z "$agent" ] && agent="planner"
echo -e "${BOLD}Goal:${RESET} $goal_desc"
echo -e "${CYAN}[step $n]${RESET} Running agent=[$agent] pattern=[$pattern]..."
local output
output=$(claude --agent "$agent" "step $n of goal: $goal_desc" 2>&1) || true
mark_step_done "$f" "$n" "$output"
local next_n
next_n=$(goal_next_step "$f")
echo ""
echo " Step $n done."
echo " me step $next_n → chạy step tiếp theo"
echo " me goal show → xem goal hiện tại"
}

# ── goal chain: execute a YAML chain of goals ───────────────────
run_goal_chain() {
  local chain_file="${1:-}"
  [ -z "$chain_file" ] && { log_error "Usage: me goal chain <file.yaml>"; exit 1; }
  [ ! -f "$chain_file" ] && { log_error "File not found: $chain_file"; exit 1; }
  echo -e "${BOLD}⛓️ Goal Chain${RESET} $chain_file"
  echo ""
  local -a goals patterns
  local i=0
  while IFS= read -r line; do
    if echo "$line" | grep -qE '^[[:space:]]*- goal:'; then
      g=$(echo "$line" | sed 's/.*goal:[[:space:]]*"\?\([^"]*\)"\?/\1/')
      goals[$i]="$g"
      patterns[$i]=""
      i=$((i+1))
    elif echo "$line" | grep -qE '^[[:space:]]*pattern:'; then
      p=$(echo "$line" | sed 's/.*pattern:[[:space:]]*//')
      p=$(echo "$p" | tr '[:upper:]' '[:lower:]' | xargs)
      patterns[$((i-1))]="$p"
    fi
  done < "$chain_file"
  local total=${#goals[@]}
  [ "$total" -eq 0 ] && { log_error "No goals found in $chain_file"; exit 1; }
  echo -e "Found ${BOLD}$total${RESET} goal(s) in chain."
  echo ""
  local j
  for j in $(seq 0 $((total-1))); do
    local g="${goals[$j]}"
    local p="${patterns[$j]:-orchestrator}"
    echo -e "${CYAN}[$((j+1))/$total]${RESET} Goal: $g  (pattern=$p)"
    create_goal "$g" "$p" >/dev/null 2>&1
    log_info "Goal created. Run: me step 1"
    read -r -p "Continue to next goal? [Y/n] " ans
    [ "${ans,,}" = "n" ] && { log_info "Chain paused at goal $((j+1))."; break; }
    echo ""
  done
  log_ok "Chain complete: $total goal(s)."
}

# ── help ────────────────────────────────────────────────────
show_help() { cat << 'HELP_EOF'
🤖 me-deep-wrapper v1.0.0 — CEO Solo Company Orchestrator

USAGE
  me <subcommand> [options] [args...]
  me help              # this message
  me help <command>    # help for a specific command

CORE COMMANDS
  idea <goal>          Goal → step plan (Harness Engineering)
  goal show            Show current goal
  goal chain <file>    Execute chain of goals
  step <N>             Execute step N of current goal
  agents list          List all 29 agents
  agents suggest       Suggest agent for a command
  project <scope>      Run at project scope
  chain '<c1> && <c2>' Chain commands
  solo [status|pdf]    Solo Company status

CLI WRAPPING (agent auto-detection)
  mekong <cmd>         mekong-cli with agent context
  claudekit <cmd>      claudekit with agent context
  claude <args>        claude (Opus 4.7)
  Examples:
    me mekong cook         → mekong cook [agent: cook-agent]
    me mekong audit-plan   → mekong audit-plan [agent: audit-expert]
    me mekong bridge       → mekong bridge [agent: fullstack-dev]
    me mekong revenue      → mekong revenue [agent: revenue-agent]
    me claudekit lint      → claudekit lint [agent: code-quality]

ENVIRONMENT VARIABLES
  MEKONG_WRAPPER_VERBOSE=1      Verbose
  MEKONG_WRAPPER_AGENT=<id>     Override agent
  MEKONG_MODEL=<model>          Override model
  PROJECT_ROOT=/path            Override root

OPTIONS
  --pattern <id>      Harness pattern
  --auto              Auto-detect pattern
  --chain <file.yaml> Chain goals
  --help, -h          Show this message

For detailed help: me help <subcommand> | <subcommand> --help
HELP_EOF
}
# ── Main dispatch ───────────────────────────────────────────
main() {
  local sub="${1:-help}"; shift || true

  case "$sub" in
    help|--help|-h) show_help; exit 0 ;;
    agents)        cmd_agents "$@" ;;
 goal)
  local gsub="${1:-show}"; shift || true
  case "$gsub" in
  show) show_goal "$@" ;;
  step) run_step "$@" ;;
  chain) run_goal_chain "$@" ;;
  *) create_goal "$gsub $*" ;;
  esac
 ;;
step) run_step "$@" ;;
goal-chain|goalchain) run_goal_chain "$@" ;;
    idea)    run_idea "$@" ;;
    project) cmd_project "$@" ;;
    chain)   cmd_chain "$@" ;;
    solo)    cmd_solo "$@" ;;
    mekong)  run_mekong "$@" ;;
    claudekit|ck) run_claudekit "$@" ;;
    claude)  run_claude "$@" ;;
    mekong_raw|claudekit_raw|claude_raw)
      local bin_name="${sub%_raw}"
      local bin; bin=$(which "$bin_name" 2>/dev/null || echo "/opt/homebrew/bin/$bin_name")
      cd "$PROJECT_ROOT"
      exec "$bin" "$@"
      ;;
    *) log_error "Unknown: me $sub"; show_help; exit 1 ;;
  esac
}

main "$@"
