#!/usr/bin/env node
import http from 'node:http';
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { readFile } from 'node:fs/promises';
import { homedir } from 'node:os';
import { join } from 'node:path';

const PORT = Number(process.env.ZUNEF_PROXY_PORT || 3091);
const HOST = process.env.ZUNEF_PROXY_HOST || '127.0.0.1';
const UPSTREAM = process.env.ZUNEF_UPSTREAM || 'https://claude-api.zunef.com/v1/ai/v1/messages';
const HELPER = process.env.ZUNEF_HELPER || '/Users/macbook/mekongmind/scripts/mekong-cli/zunef-api-key-helper.py';
const HEDGE_DELAY_MS = Number(process.env.ZUNEF_HEDGE_DELAY_MS || 120);
const DUPLICATE_ATTEMPTS = Number(process.env.ZUNEF_DUPLICATE_ATTEMPTS || 5);
const DUPLICATE_DELAY_MS = Number(process.env.ZUNEF_DUPLICATE_DELAY_MS || 220);
const FIRST_OUTPUT_TIMEOUT_MS = Number(
  process.env.ZUNEF_FIRST_OUTPUT_TIMEOUT_MS || process.env.ZUNEF_FIRST_TEXT_TIMEOUT_MS || 45000,
);
const DISABLE_PARALLEL_TOOL_USE = process.env.ZUNEF_DISABLE_PARALLEL_TOOL_USE !== '0';
const MARKDOWN_GUARD = process.env.ZUNEF_MARKDOWN_GUARD === '0'
  ? ''
  : 'Markdown rendering guard: for user-visible long answers and reports, put blank lines before and after headings, lists, tables, horizontal rules, and code fences. Never inline markdown headings/tables into a paragraph. Keep table rows on separate lines. Keep short status updates as plain sentences.';
const TOOL_SCHEMA_GUARD = process.env.ZUNEF_TOOL_SCHEMA_GUARD === '0'
  ? ''
  : 'Tool-call guard: when using a tool, emit a complete JSON input object that satisfies that tool schema. Bash requires a non-empty command string. Read requires file_path. Edit requires file_path, old_string, and new_string. Never call unrelated MCP/design/browser tools during coding work unless the user explicitly asks for that tool.';
const FILTER_MCP_TOOLS = process.env.ZUNEF_FILTER_MCP_TOOLS !== '0';
const TOKEN_CACHE_TTL_MS = Number(process.env.ZUNEF_PROXY_TOKEN_CACHE_TTL_MS || 600000);
const TOKEN_CACHE_SKEW_MS = Number(process.env.ZUNEF_PROXY_TOKEN_CACHE_SKEW_MS || 30000);
const FAST_MODEL = process.env.ZUNEF_FAST_MODEL || process.env.ANTHROPIC_MODEL || 'claude-sonnet-4-6';
const REWRITE_OPUS_TO_FAST = process.env.ZUNEF_REWRITE_OPUS_TO_FAST !== '0';
const MAX_TOKENS_CAP = Number(process.env.ZUNEF_MAX_TOKENS_CAP || 20000);
const TOOL_MAX_TOKENS_CAP = Number(process.env.ZUNEF_TOOL_MAX_TOKENS_CAP || 4096);

const tokenCache = new Map();
const sseEncoder = new TextEncoder();

async function loadAccounts() {
  if (process.env.ZUNEF_AUTH_URLS) {
    return process.env.ZUNEF_AUTH_URLS.split(',')
      .map((authUrl, index) => ({ name: `env-${index + 1}`, authUrl: authUrl.trim() }))
      .filter((account) => account.authUrl);
  }
  const configPath = process.env.ZUNEF_ACCOUNTS_FILE || join(homedir(), '.config/mekongmind/zunef-accounts.json');
  const parsed = JSON.parse(await readFile(configPath, 'utf8'));
  const accounts = Array.isArray(parsed) ? parsed : parsed.accounts;
  if (!Array.isArray(accounts) || accounts.length === 0) {
    throw new Error(`No Zunef accounts in ${configPath}`);
  }
  return accounts.filter((account) => account && account.authUrl);
}

function fetchToken(authUrl) {
  const helperStarted = Date.now();
  return new Promise((resolve, reject) => {
    const child = spawn(HELPER, [authUrl], { stdio: ['ignore', 'pipe', 'pipe'] });
    let stdout = '';
    let stderr = '';
    child.stdout.on('data', (chunk) => { stdout += chunk; });
    child.stderr.on('data', (chunk) => { stderr += chunk; });
    child.on('error', reject);
    child.on('close', (code) => {
      const token = stdout.trim();
      if (code === 0 && token) resolve({ token, helperMs: Date.now() - helperStarted });
      else reject(new Error(`helper failed exit=${code} stderr_present=${Boolean(stderr.trim())}`));
    });
  });
}

async function getToken(authUrl) {
  const now = Date.now();
  const cached = tokenCache.get(authUrl);
  if (cached?.token && now < cached.expiresAt - TOKEN_CACHE_SKEW_MS) {
    return { token: cached.token, tokenMs: 0, tokenCacheHit: true };
  }
  if (cached?.inflight) {
    const token = await cached.inflight;
    return { token, tokenMs: Date.now() - now, tokenCacheHit: false, tokenInflightHit: true };
  }
  const inflight = fetchToken(authUrl)
    .then(({ token, helperMs }) => {
      tokenCache.set(authUrl, {
        token,
        expiresAt: Date.now() + TOKEN_CACHE_TTL_MS,
        lastHelperMs: helperMs,
      });
      return token;
    })
    .catch((error) => {
      tokenCache.delete(authUrl);
      throw error;
    });
  tokenCache.set(authUrl, {
    token: cached?.token,
    expiresAt: cached?.expiresAt || 0,
    inflight,
  });
  const token = await inflight;
  return { token, tokenMs: Date.now() - now, tokenCacheHit: false };
}

function invalidateToken(authUrl) {
  tokenCache.delete(authUrl);
}

function wait(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function systemHasGuard(system, marker) {
  if (!marker) return true;
  const firstLine = marker.split(':', 1)[0];
  if (typeof system === 'string') return system.includes(`${firstLine}:`);
  if (Array.isArray(system)) {
    return system.some((block) => typeof block?.text === 'string' && block.text.includes(`${firstLine}:`));
  }
  return false;
}

function appendSystemGuard(payload, marker) {
  if (systemHasGuard(payload.system, marker)) return false;
  if (!payload.system) {
    payload.system = marker;
    return true;
  }
  if (typeof payload.system === 'string') {
    payload.system = `${payload.system}\n\n${marker}`;
    return true;
  }
  if (Array.isArray(payload.system)) {
    payload.system = [
      ...payload.system,
      { type: 'text', text: marker },
    ];
    return true;
  }
  return false;
}

function systemBytes(system) {
  if (typeof system === 'string') return Buffer.byteLength(system);
  if (Array.isArray(system)) {
    return system.reduce((total, block) => total + Buffer.byteLength(String(block?.text || '')), 0);
  }
  return 0;
}

function rewriteRequestBody(body, headers) {
  const contentType = String(headers['content-type'] || '');
  if (!contentType.includes('application/json')) {
    return {
      body,
      rewroteToolChoice: false,
      rewroteMarkdownGuard: false,
      rewroteToolSchemaGuard: false,
      filteredMcpTools: 0,
      requestMeta: {},
    };
  }
  let payload;
  try {
    payload = JSON.parse(body.toString('utf8'));
  } catch {
    return {
      body,
      rewroteToolChoice: false,
      rewroteMarkdownGuard: false,
      rewroteToolSchemaGuard: false,
      filteredMcpTools: 0,
      requestMeta: {},
    };
  }
  let filteredMcpTools = 0;
  if (FILTER_MCP_TOOLS && Array.isArray(payload.tools)) {
    const originalToolCount = payload.tools.length;
    payload.tools = payload.tools.filter((tool) => !String(tool?.name || '').startsWith('mcp__'));
    filteredMcpTools = originalToolCount - payload.tools.length;
  }
  const originalModel = typeof payload.model === 'string' ? payload.model : undefined;
  let rewroteModel = false;
  if (REWRITE_OPUS_TO_FAST && originalModel?.includes('opus') && FAST_MODEL && FAST_MODEL !== originalModel) {
    payload.model = FAST_MODEL;
    rewroteModel = true;
  }
  const toolCount = Array.isArray(payload.tools) ? payload.tools.length : 0;
  const effectiveMaxTokensCap = toolCount > 0 && Number.isFinite(TOOL_MAX_TOKENS_CAP) && TOOL_MAX_TOKENS_CAP > 0
    ? Math.min(MAX_TOKENS_CAP, TOOL_MAX_TOKENS_CAP)
    : MAX_TOKENS_CAP;
  let rewroteMaxTokens = false;
  if (
    Number.isFinite(effectiveMaxTokensCap)
    && effectiveMaxTokensCap > 0
    && Number(payload.max_tokens) > effectiveMaxTokensCap
  ) {
    payload.max_tokens = effectiveMaxTokensCap;
    rewroteMaxTokens = true;
  }
  const requestMeta = {
    model: typeof payload.model === 'string' ? payload.model : undefined,
    originalModel,
    toolCount,
    systemBytes: systemBytes(payload.system),
    messageCount: Array.isArray(payload.messages) ? payload.messages.length : 0,
    maxTokens: payload.max_tokens,
    effectiveMaxTokensCap,
    rewroteModel,
    rewroteMaxTokens,
  };
  const rewroteMarkdownGuard = appendSystemGuard(payload, MARKDOWN_GUARD);
  const rewroteToolSchemaGuard = appendSystemGuard(payload, TOOL_SCHEMA_GUARD);
  let rewroteToolChoice = false;
  if (DISABLE_PARALLEL_TOOL_USE && Array.isArray(payload.tools) && payload.tools.length > 0) {
    if (payload.tool_choice && typeof payload.tool_choice === 'object' && !Array.isArray(payload.tool_choice)) {
      if (payload.tool_choice.disable_parallel_tool_use !== true) {
        payload.tool_choice = {
          ...payload.tool_choice,
          disable_parallel_tool_use: true,
        };
        rewroteToolChoice = true;
      }
    } else {
      payload.tool_choice = {
        type: 'auto',
        disable_parallel_tool_use: true,
      };
      rewroteToolChoice = true;
    }
  }
  if (
    !rewroteMarkdownGuard
    && !rewroteToolSchemaGuard
    && !rewroteToolChoice
    && !rewroteModel
    && !rewroteMaxTokens
    && filteredMcpTools === 0
  ) {
    return {
      body,
      rewroteToolChoice: false,
      rewroteMarkdownGuard: false,
      rewroteToolSchemaGuard: false,
      filteredMcpTools: 0,
      requestMeta,
    };
  }
  return {
    body: Buffer.from(JSON.stringify(payload)),
    rewroteToolChoice,
    rewroteMarkdownGuard,
    rewroteToolSchemaGuard,
    filteredMcpTools,
    requestMeta,
  };
}

function firstOutputFromEvent(event) {
  if (event?.type === 'content_block_delta') {
    const delta = event.delta || {};
    if (delta.text) return 'text_delta';
    if (delta.partial_json) return 'tool_use_input_delta';
    if (delta.type === 'input_json_delta') return 'tool_use_input_delta';
  }
  if (event?.type === 'message_delta' && event?.delta?.stop_reason) {
    return 'message_delta';
  }
  return null;
}

function parseDataLines(buffer, chunk) {
  buffer.text += new TextDecoder().decode(chunk, { stream: true });
  let newlineIndex = buffer.text.search(/\r?\n/);
  while (newlineIndex >= 0) {
    const line = buffer.text.slice(0, newlineIndex).trim();
    buffer.text = buffer.text.slice(buffer.text[newlineIndex] === '\r' ? newlineIndex + 2 : newlineIndex + 1);
    if (line.startsWith('data: ')) {
      const data = line.slice(6);
      if (data !== '[DONE]') {
        try {
          const event = JSON.parse(data);
          const firstOutputEvent = firstOutputFromEvent(event);
          if (firstOutputEvent) return firstOutputEvent;
        } catch {
          // Ignore partial or vendor-specific events.
        }
      }
    }
    newlineIndex = buffer.text.search(/\r?\n/);
  }
  return false;
}

async function startCandidate(candidate, body, headers, controllers) {
  const started = Date.now();
  const { token, tokenMs, tokenCacheHit, tokenInflightHit } = await getToken(candidate.account.authUrl);
  const fetchStarted = Date.now();
  const controller = new AbortController();
  controllers.add(controller);
  const response = await fetch(UPSTREAM, {
    method: 'POST',
    headers: {
      'content-type': headers['content-type'] || 'application/json',
      'accept': 'text/event-stream',
      'connection': 'keep-alive',
      'anthropic-version': headers['anthropic-version'] || '2023-06-01',
      'x-zunef-client': 'claude-code',
      'x-api-key': token,
    },
    body,
    signal: controller.signal,
  });
  const headersMs = Date.now() - fetchStarted;
  if (!response.ok || !response.body) {
    const text = await response.text().catch(() => '');
    if (response.status === 401 || response.status === 403) {
      invalidateToken(candidate.account.authUrl);
    }
    throw new Error(`${candidate.name} upstream ${response.status} bytes=${text.length}`);
  }
  const reader = response.body.getReader();
  const chunks = [];
  const lineBuffer = { text: '' };
  let firstOutputMs = null;
  while (true) {
    const { value, done } = await reader.read();
    if (done) throw new Error(`${candidate.name} ended before output`);
    chunks.push(value);
    const firstOutputEvent = parseDataLines(lineBuffer, value);
    if (firstOutputEvent) {
      firstOutputMs = Date.now() - started;
      return {
        candidate,
        response,
        reader,
        chunks,
        controller,
        firstOutputMs,
        firstOutputEvent,
        tokenMs,
        tokenCacheHit,
        tokenInflightHit: Boolean(tokenInflightHit),
        headersMs,
      };
    }
  }
}

async function chooseCandidate(accounts, body, headers) {
  const controllers = new Set();
  let settled = false;
  let lastError;
  const candidates = [];
  for (let attempt = 0; attempt < DUPLICATE_ATTEMPTS; attempt += 1) {
    accounts.forEach((account, accountIndex) => {
      const suffix = attempt === 0 ? '' : `#${attempt + 1}`;
      candidates.push({
        account,
        name: `${account.name}${suffix}`,
        delayMs: (attempt * DUPLICATE_DELAY_MS) + (accountIndex * HEDGE_DELAY_MS),
      });
    });
  }
  const launch = async (candidate) => {
    if (candidate.delayMs > 0) await wait(candidate.delayMs);
    if (settled) throw new Error(`${candidate.name} skipped after winner`);
    return startCandidate(candidate, body, headers, controllers);
  };
  const pending = candidates.map((candidate) => launch(candidate).catch((error) => {
    lastError = error;
    throw error;
  }));
  const timeout = wait(FIRST_OUTPUT_TIMEOUT_MS).then(() => {
    throw new Error(`first output timeout; last_error=${lastError?.message || 'none'}`);
  });
  const winner = await Promise.race([
    Promise.any(pending),
    timeout,
  ]);
  settled = true;
  for (const controller of controllers) {
    if (controller !== winner.controller) controller.abort();
  }
  return winner;
}

function writeHeaders(res, upstreamResponse) {
  res.writeHead(upstreamResponse.status, {
    'content-type': upstreamResponse.headers.get('content-type') || 'text/event-stream',
    'cache-control': 'no-cache',
    'connection': 'keep-alive',
  });
}

function formatSseEvent(event) {
  if (!event) return Buffer.alloc(0);
  if (event.raw) return Buffer.from(event.raw);
  if (event.done) return sseEncoder.encode('data: [DONE]\n\n');
  const type = event.data?.type || event.event || 'message';
  return sseEncoder.encode(`event: ${type}\ndata: ${JSON.stringify(event.data)}\n\n`);
}

function createSseToolSanitizer() {
  const decoder = new TextDecoder();
  const state = {
    text: '',
    pendingTool: null,
  };

  const parseEvent = (rawEvent) => {
    let eventName = null;
    const dataLines = [];
    for (const rawLine of rawEvent.split(/\r?\n/)) {
      const line = rawLine.trimEnd();
      if (line.startsWith('event:')) eventName = line.slice(6).trim();
      if (line.startsWith('data:')) dataLines.push(line.slice(5).trimStart());
    }
    if (dataLines.length === 0) return { raw: `${rawEvent}\n\n` };
    const data = dataLines.join('\n');
    if (data === '[DONE]') return { done: true };
    try {
      return { event: eventName, data: JSON.parse(data) };
    } catch {
      return { raw: `${rawEvent}\n\n` };
    }
  };

  const emitTool = (tool) => {
    if (!tool) return [];
    if (tool.partialJson.trim()) {
      try {
        const parsedInput = JSON.parse(tool.partialJson);
        if (parsedInput == null || typeof parsedInput !== 'object' || Array.isArray(parsedInput)) {
          return tool.rawEvents.map(formatSseEvent);
        }
      } catch {
        return tool.rawEvents.map(formatSseEvent);
      }
    }
    return tool.rawEvents.map(formatSseEvent);
  };

  const handleEvent = (event) => {
    const data = event.data;
    if (!data?.type) return [formatSseEvent(event)];
    if (data.type === 'content_block_start' && data.content_block?.type === 'tool_use') {
      state.pendingTool = {
        index: data.index,
        startEvent: event,
        rawEvents: [event],
        partialJson: '',
      };
      return [];
    }
    if (state.pendingTool && data.index === state.pendingTool.index) {
      state.pendingTool.rawEvents.push(event);
      if (data.type === 'content_block_delta') {
        const delta = data.delta || {};
        if (typeof delta.partial_json === 'string') state.pendingTool.partialJson += delta.partial_json;
        return [];
      }
      if (data.type === 'content_block_stop') {
        const output = emitTool(state.pendingTool);
        state.pendingTool = null;
        return output;
      }
    }
    return [formatSseEvent(event)];
  };

  const feed = (chunk) => {
    state.text += decoder.decode(chunk, { stream: true });
    const outputs = [];
    let separator = state.text.search(/\r?\n\r?\n/);
    while (separator >= 0) {
      const rawEvent = state.text.slice(0, separator);
      const newlineLength = state.text.slice(separator).startsWith('\r\n\r\n') ? 4 : 2;
      state.text = state.text.slice(separator + newlineLength);
      outputs.push(...handleEvent(parseEvent(rawEvent)));
      separator = state.text.search(/\r?\n\r?\n/);
    }
    return outputs;
  };

  const flush = () => {
    const outputs = [];
    if (state.pendingTool) {
      outputs.push(...state.pendingTool.rawEvents.map(formatSseEvent));
      state.pendingTool = null;
    }
    if (state.text) outputs.push(Buffer.from(state.text));
    state.text = '';
    return outputs;
  };

  return { feed, flush };
}

function parseSsePayloads(chunks) {
  return chunks
    .map((chunk) => Buffer.from(chunk).toString('utf8'))
    .join('')
    .split(/\r?\n\r?\n/)
    .flatMap((rawEvent) => rawEvent.split(/\r?\n/).filter((line) => line.startsWith('data: ')))
    .map((line) => line.slice(6))
    .filter((data) => data && data !== '[DONE]')
    .map((data) => JSON.parse(data));
}

function sseEvent(data) {
  return sseEncoder.encode(`event: ${data.type}\ndata: ${JSON.stringify(data)}\n\n`);
}

function runSelfTest() {
  const sanitizer = createSseToolSanitizer();
  const toolStart = {
    type: 'content_block_start',
    index: 1,
    content_block: {
      type: 'tool_use',
      id: 'tool-test',
      name: 'Bash',
      input: {},
    },
  };
  const toolDelta = {
    type: 'content_block_delta',
    index: 1,
    delta: {
      type: 'input_json_delta',
      partial_json: '{"command":"printf self_test_ok"}',
    },
  };
  const toolStop = {
    type: 'content_block_stop',
    index: 1,
  };

  assert.deepEqual(sanitizer.feed(sseEvent(toolStart)), []);
  assert.deepEqual(sanitizer.feed(sseEvent(toolDelta)), []);
  const output = sanitizer.feed(sseEvent(toolStop));
  const payloads = parseSsePayloads(output);
  assert.equal(payloads.length, 3);
  assert.equal(payloads[0].type, 'content_block_start');
  assert.equal(payloads[1].type, 'content_block_delta');
  assert.equal(payloads[2].type, 'content_block_stop');
  assert.equal(payloads[0].content_block.name, 'Bash');
  assert.equal(payloads[1].delta.partial_json, '{"command":"printf self_test_ok"}');
  assert.deepEqual(sanitizer.flush(), []);
  console.error(JSON.stringify({ event: 'zunef_proxy_self_test', ok: true }));
}

async function pipeWinner(winner, res) {
  writeHeaders(res, winner.response);
  const sanitizer = createSseToolSanitizer();
  for (const chunk of winner.chunks) {
    for (const output of sanitizer.feed(chunk)) res.write(Buffer.from(output));
  }
  while (!res.destroyed) {
    const { value, done } = await winner.reader.read();
    if (done) break;
    for (const output of sanitizer.feed(value)) res.write(Buffer.from(output));
  }
  for (const output of sanitizer.flush()) res.write(Buffer.from(output));
  res.end();
}

if (process.env.ZUNEF_PROXY_SELF_TEST === '1') {
  runSelfTest();
  process.exit(0);
}

const accounts = await loadAccounts();
const prewarmResults = await Promise.allSettled(accounts.map((account) => getToken(account.authUrl)));
console.error(JSON.stringify({
  event: 'zunef_proxy_token_prewarm',
  ok: prewarmResults.filter((result) => result.status === 'fulfilled').length,
  failed: prewarmResults.filter((result) => result.status === 'rejected').length,
}));
const server = http.createServer(async (req, res) => {
  const pathname = new URL(req.url || '/', 'http://127.0.0.1').pathname;
  if (req.method === 'GET' && pathname === '/health') {
    res.writeHead(200, { 'content-type': 'application/json' });
    res.end(JSON.stringify({
      ok: true,
      accounts: accounts.length,
      hedgeDelayMs: HEDGE_DELAY_MS,
      duplicateAttempts: DUPLICATE_ATTEMPTS,
      duplicateDelayMs: DUPLICATE_DELAY_MS,
      firstOutputTimeoutMs: FIRST_OUTPUT_TIMEOUT_MS,
      disableParallelToolUse: DISABLE_PARALLEL_TOOL_USE,
      markdownGuard: Boolean(MARKDOWN_GUARD),
      tokenCacheTtlMs: TOKEN_CACHE_TTL_MS,
      tokenCacheEntries: [...tokenCache.values()].filter((entry) => entry.token).length,
      rewriteOpusToFast: REWRITE_OPUS_TO_FAST,
      fastModel: FAST_MODEL,
      maxTokensCap: MAX_TOKENS_CAP,
      toolMaxTokensCap: TOOL_MAX_TOKENS_CAP,
      filterMcpTools: FILTER_MCP_TOOLS,
      toolSchemaGuard: Boolean(TOOL_SCHEMA_GUARD),
      bufferToolUseBlocks: true,
    }));
    return;
  }
  if (req.method !== 'POST' || !pathname.endsWith('/messages')) {
    res.writeHead(404, { 'content-type': 'application/json' });
    res.end(JSON.stringify({ error: 'not_found' }));
    return;
  }
  const chunks = [];
  for await (const chunk of req) chunks.push(chunk);
  const originalBody = Buffer.concat(chunks);
  const {
    body,
    rewroteToolChoice,
    rewroteMarkdownGuard,
    rewroteToolSchemaGuard,
    filteredMcpTools,
    requestMeta,
  } = rewriteRequestBody(originalBody, req.headers);
  const started = Date.now();
  try {
    const winner = await chooseCandidate(accounts, body, req.headers);
    console.error(JSON.stringify({
      event: 'zunef_proxy_winner',
      account: winner.candidate.name,
      firstOutputMs: winner.firstOutputMs,
      firstOutputEvent: winner.firstOutputEvent,
      tokenMs: winner.tokenMs,
      tokenCacheHit: winner.tokenCacheHit,
      tokenInflightHit: winner.tokenInflightHit,
      headersMs: winner.headersMs,
      totalSelectMs: Date.now() - started,
      rewroteToolChoice,
      rewroteMarkdownGuard,
      rewroteToolSchemaGuard,
      filteredMcpTools,
      ...requestMeta,
    }));
    await pipeWinner(winner, res);
  } catch (error) {
    res.writeHead(502, { 'content-type': 'application/json' });
    res.end(JSON.stringify({ error: 'zunef_proxy_failed', message: error.message }));
  }
});

server.listen(PORT, HOST, () => {
  console.error(JSON.stringify({ event: 'zunef_proxy_listening', host: HOST, port: PORT, accounts: accounts.length }));
});
