  local root="$1"; shift
  local rel
  for rel in "$@"; do
    [ -e "$root/$rel" ] && { echo "$root/$rel"; return 0; }
  done
  return 1
}

artifact_path_for_gate() {
  local gate="${1:-}"
  case "$gate" in
    company-blueprint) echo ".mekong/company.json" ;;
    offer-validated) echo "state/evidence/offer-validated.json" ;;
    mvp-live) echo "state/evidence/mvp-live.json" ;;
