path, goal_id, current_gate = sys.argv[1:4]
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
gates = [
    "idea-intake",
    "company-blueprint",
    "offer-validated",
    "mvp-live",
    "first-revenue",
    "repeatable-channel",
    "fulfillment-stable",
    "scale-ready",
    "first-1m-mrr",
