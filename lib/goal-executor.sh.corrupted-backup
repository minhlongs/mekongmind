  if [ -n "${PROJECT_ROOT:-}" ]; then
    echo "$PROJECT_ROOT"
    return 0
  fi
  local registry_dir
  registry_dir=$(dirname "$REGISTRY_FILE")
  (cd "$registry_dir/.." 2>/dev/null && pwd) || pwd
}

_has_any_artifact() {
  local root="$1"; shift
  local rel
  for rel in "$@"; do
    [ -e "$root/$rel" ] && { echo "$root/$rel"; return 0; }
  done
  return 1
}

