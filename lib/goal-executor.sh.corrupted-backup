validate_department_artifact() {
  local department="${1:-}"
  local artifact="${2:-}"
  [ -z "$department" ] && { echo "ERROR: department required" >&2; return 1; }
  local root
  root=$(_gate_artifact_root)
  python3 - "$REGISTRY_FILE" "$department" "$root" "$artifact" <<'PY'
import json, os, sys
registry_path, department, root, artifact = sys.argv[1:5]
with open(registry_path) as f:
    registry = json.load(f)
contracts = registry.get("mekongmind_evidence_contracts", [])
contract = next((c for c in contracts if c.get("department") == department), None)
if not contract:
    raise SystemExit(f"ERROR: unknown evidence contract department: {department}")
artifact_path = artifact or os.path.join(root, contract["artifact_path"])
if not os.path.isabs(artifact_path):
    artifact_path = os.path.join(root, artifact_path)
if not os.path.exists(artifact_path):
    raise SystemExit(f"MISS {department} artifact not found: {artifact_path}")
try:
    with open(artifact_path) as f:
        data = json.load(f)
except Exception as exc:
    raise SystemExit(f"FAIL {department} artifact is not valid JSON: {artifact_path} ({exc})")
missing = []
empty = []
for field in contract.get("required_fields", []):
    source = data
    if field not in source and isinstance(data.get("evidence"), dict):
        source = data["evidence"]
    if field not in source:
        missing.append(field)
        continue
    value = source[field]
    if value in ("", None, [], {}):
        empty.append(field)
if missing or empty:
    if missing:
        print(f"MISS {department} missing fields: {', '.join(missing)}")
    if empty:
        print(f"MISS {department} empty fields: {', '.join(empty)}")
    print(f"Artifact: {artifact_path}")
    print(f"ProofRule: {contract.get('proof_rule','')}")
    raise SystemExit(1)

def value(name):
    if name in data:
        return data.get(name)
    if isinstance(data.get("evidence"), dict):
        return data["evidence"].get(name)
    return None

def text(name):
    raw = value(name)
    if isinstance(raw, (dict, list)):
        return json.dumps(raw, sort_keys=True)
    return "" if raw is None else str(raw)

semantic_failures = []
if department == "quality-compliance":
    decision = text("release_decision").lower()
    if any(term in decision for term in ("block", "blocked", "not approved", "fail", "failed")):
        semantic_failures.append("release_decision is blocking, not releasable")
if department == "platform-operations":
    status = text("http_status").strip()
    if status != "200":
        semantic_failures.append("http_status must be 200")
    version_match = text("version_match").lower()
    if version_match not in ("true", "yes", "matched", "match", "verified"):
        semantic_failures.append("version_match must be verified")
    provider = text("provider").lower()
    if any(term in provider for term in ("unknown", "blocked", "missing")):
        semantic_failures.append("provider must be a real reachable provider")
if department == "growth-marketing":
    outreach_log = value("outreach_log")
    if not isinstance(outreach_log, list) or not outreach_log:
        semantic_failures.append("outreach_log must be a non-empty list of real send/reply events")
    else:
        sent_events = 0
        opt_out_events = 0
        for idx, event in enumerate(outreach_log, start=1):
            if not isinstance(event, dict):
                semantic_failures.append(f"outreach_log[{idx}] must be an object")
                continue
            if not (event.get("sent_at") or event.get("date") or event.get("timestamp")):
                semantic_failures.append(f"outreach_log[{idx}] missing sent_at/date/timestamp")
            if not (event.get("recipient") or event.get("recipient_id") or event.get("audience_ref")):
                semantic_failures.append(f"outreach_log[{idx}] missing recipient/recipient_id/audience_ref")
            if not (event.get("recipient_source") or event.get("source") or event.get("audience_source")):
                semantic_failures.append(f"outreach_log[{idx}] missing recipient_source/source/audience_source")
            status = str(event.get("status", "")).lower()
            if not status:
                semantic_failures.append(f"outreach_log[{idx}] missing status")
            if status in {"sent", "delivered", "replied", "reply", "opened", "bounced"}:
                sent_events += 1
            opt_out = event.get("opt_out_notice")
            if opt_out is True or (isinstance(opt_out, str) and opt_out.strip()):
                opt_out_events += 1
        if sent_events <= 0:
            semantic_failures.append("outreach_log must include at least one sent/delivered/replied/opened/bounced event")
        if opt_out_events < sent_events:
            semantic_failures.append("every sent outreach event must record opt_out_notice")
    compliance = text("opt_out_compliance").lower()
    if "opt" not in compliance:
        semantic_failures.append("opt_out_compliance must describe opt-out handling")
    handoff = value("sales_handoff")
    if handoff in ("", None, [], {}):
        semantic_failures.append("sales_handoff must record Sales handoff even when qualified leads are zero")
if department == "sales-revenue":
    provider = text("provider").lower()
    if "polar" not in provider:
        semantic_failures.append("provider must be Polar.sh")
    sync_status = text("provider_sync_status").lower()
    if not any(term in sync_status for term in ("synced", "verified", "provider-backed", "provider backed")):
        semantic_failures.append("provider_sync_status must be synced or verified")
    payment_status = text("payment_status").lower()
    if not any(term in payment_status for term in ("paid", "active", "signed", "subscription")):
        semantic_failures.append("payment_status must prove paid, active, signed, or subscription")
    raw_mrr = value("current_mrr")
    try:
        mrr = float(raw_mrr)
    except (TypeError, ValueError):
        mrr = 0.0
    if mrr <= 0:
        semantic_failures.append("current_mrr must be greater than 0")
if semantic_failures:
    print(f"FAIL {department} semantic contract")
    for failure in semantic_failures:
        print(f"- {failure}")
    print(f"Artifact: {artifact_path}")
    print(f"ProofRule: {contract.get('proof_rule','')}")
    raise SystemExit(1)
print(f"PASS {department} artifact contract")
print(f"Artifact: {artifact_path}")
print(f"Gate: {contract.get('gate','')}")
print(f"RequiredFields: {', '.join(contract.get('required_fields', []))}")
PY
}

render_department_artifact_template() {
  local department="${1:-}"
  local out="${2:-}"
  [ -z "$department" ] && { echo "ERROR: department required" >&2; return 1; }
  local root
  root=$(_gate_artifact_root)
  python3 - "$REGISTRY_FILE" "$department" "$root" "$out" <<'PY'
import json, os, sys
from datetime import datetime, timezone

registry_path, department, root, out = sys.argv[1:5]
with open(registry_path) as f:
    registry = json.load(f)
contract = next((c for c in registry.get("mekongmind_evidence_contracts", []) if c.get("department") == department), None)
if not contract:
    raise SystemExit(f"ERROR: unknown evidence contract department: {department}")
data = {
    "department": department,
    "gate": contract.get("gate", ""),
    "artifact_path": contract.get("artifact_path", ""),
    "proof_rule": contract.get("proof_rule", ""),
    "updated_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
}
for field in contract.get("required_fields", []):
    data.setdefault(field, "")
payload = json.dumps(data, indent=2, sort_keys=True) + "\n"
if out:
    path = out
    if not os.path.isabs(path):
        path = os.path.join(root, path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(payload)
    print(path)
else:
    sys.stdout.write(payload)
PY
}

