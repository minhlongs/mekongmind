generate_product_release_readiness_packet() {
  local goal_id="${1:-}"
  local root queue_file blueprint offer mvp
  root="$(_gate_artifact_root)"
  queue_file="$(product_self_selling_queue_file)"
  blueprint="$root/state/evidence/company-blueprint.json"
  offer="$root/state/evidence/offer-validated.json"
  mvp="$root/state/evidence/mvp-live.json"
  [ -f "$blueprint" ] || { echo "ERROR: company blueprint missing: $blueprint" >&2; return 1; }
  [ -f "$offer" ] || { echo "ERROR: offer artifact missing: $offer" >&2; return 1; }
  [ -f "$mvp" ] || { echo "ERROR: mvp-live artifact missing: $mvp" >&2; return 1; }
  python3 - "$root" "$queue_file" "$blueprint" "$offer" "$mvp" "$goal_id" <<'PY'
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone

root, queue_path, blueprint_path, offer_path, mvp_path, goal_id = sys.argv[1:7]
blueprint = json.load(open(blueprint_path))
offer = json.load(open(offer_path))
mvp = json.load(open(mvp_path))
product_name = blueprint.get("product_name") or os.path.basename(str(blueprint.get("product_path", "")).rstrip("/")) or "product"
product_path = blueprint.get("product_path", "")
safe_base = re.sub(r"[^a-zA-Z0-9._-]+", "-", product_name).strip("-") or "product"
path_hash = hashlib.sha1(product_path.encode("utf-8")).hexdigest()[:8] if product_path else ""
safe = f"{safe_base}-{path_hash}" if path_hash else safe_base
snapshot_dir = os.path.join(root, "state", "products", "evidence", safe)
os.makedirs(snapshot_dir, exist_ok=True)
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

def nested_value(data, field):
    if field in data:
        return data.get(field)
    evidence = data.get("evidence")
    if isinstance(evidence, dict):
        return evidence.get(field)
    return None

def non_empty(value):
    return value not in ("", None, [], {})

def text(field):
    value = nested_value(mvp, field)
    if isinstance(value, (dict, list)):
        return json.dumps(value, sort_keys=True)
    return "" if value is None else str(value)

contracts = {
    "engineering-factory": [
        "routes", "apis", "data_model", "integrations", "checkout_path",
        "build_command", "tests_run", "known_risks",
    ],
    "quality-compliance": [
        "review_scope", "tests_run", "build_status", "security_notes",
        "blocking_findings", "residual_risks", "release_decision",
    ],
    "platform-operations": [
        "provider", "commit", "build_id", "health_url", "http_status",
        "version_match", "rollback_plan", "monitoring",
    ],
}

def contract_check(department):
    fields = contracts[department]
    missing = [field for field in fields if field not in mvp and not (isinstance(mvp.get("evidence"), dict) and field in mvp["evidence"])]
    empty = [field for field in fields if field not in missing and not non_empty(nested_value(mvp, field))]
    semantic_failures = []
    if department == "quality-compliance":
        decision = text("release_decision").lower()
        if any(term in decision for term in ("block", "blocked", "not approved", "fail", "failed")):
            semantic_failures.append("release_decision is blocking, not releasable")
    if department == "platform-operations":
        if str(nested_value(mvp, "http_status")).strip() != "200":
            semantic_failures.append("http_status must be 200")
        version_match = text("version_match").lower()
        if version_match not in ("true", "yes", "matched", "match", "verified"):
            semantic_failures.append("version_match must be verified")
        provider = text("provider").lower()
        if any(term in provider for term in ("unknown", "blocked", "missing")):
            semantic_failures.append("provider must be a real reachable provider")
    return {
        "department": department,
        "required_fields": fields,
        "missing_fields": missing,
        "empty_fields": empty,
        "semantic_failures": semantic_failures,
        "contract_ready": not missing and not empty and not semantic_failures,
    }

checks = [contract_check(dept) for dept in ("engineering-factory", "quality-compliance", "platform-operations")]
ready_departments = [check["department"] for check in checks if check["contract_ready"]]
blocked_departments = [check["department"] for check in checks if not check["contract_ready"]]
artifact_goal_id = mvp.get("goal_id") or ""
artifact_product_name = mvp.get("product_name") or mvp.get("product") or ""
artifact_product_path = mvp.get("product_path") or ""
artifact_label = mvp.get("artifact") or mvp.get("name") or ""
if isinstance(artifact_product_name, dict):
    artifact_product_name = artifact_product_name.get("name", "")
goal_match = bool(goal_id and artifact_goal_id and goal_id == artifact_goal_id)
product_name_match = bool(product_name and artifact_product_name and product_name == artifact_product_name)
product_path_match = bool(product_path and artifact_product_path and product_path == artifact_product_path)
artifact_label_match = bool(product_name and artifact_label and product_name.lower() in str(artifact_label).lower())
artifact_binding_ready = product_name_match or product_path_match or artifact_label_match
artifact_binding = {
    "selected_product_name": product_name,
    "selected_product_path": product_path,
    "selected_goal_id": goal_id,
    "artifact_goal_id": artifact_goal_id,
    "artifact_product_name": artifact_product_name,
    "artifact_product_path": artifact_product_path,
    "artifact_label": artifact_label,
    "goal_match": goal_match,
    "product_name_match": product_name_match,
    "product_path_match": product_path_match,
    "artifact_label_match": artifact_label_match,
    "contract_ready": artifact_binding_ready,
    "semantic_failures": [] if artifact_binding_ready else [
        "mvp-live artifact is not tied to the selected product"
    ],
}
if not artifact_binding_ready:
    blocked_departments = ["artifact-binding"] + blocked_departments

packet = {
    "schema": "mekongmind.product_release_readiness_packet.v1",
    "product_name": product_name,
    "product_path": product_path,
    "goal_id": goal_id,
    "created_at": now,
    "packet_status": "blocked-release-readiness-not-proof" if blocked_departments else "ready-for-strict-mvp-live-validation",
    "guard": [
        "This packet is not mvp-live proof.",
        "This packet is not production proof.",
        "This packet is not campaign proof.",
        "This packet is not revenue proof.",
        "Do not start real outreach until Quality & Compliance and Platform Operations strict contracts pass.",
        "Do not mutate Polar.sh configuration from this packet.",
    ],
    "polar_provider": "Polar.sh canonical; checkout/subscription evidence is still required for MRR",
    "source_artifact": "state/evidence/mvp-live.json",
    "artifact_binding": artifact_binding,
    "offer": offer.get("offer") or blueprint.get("offer_direction", ""),
    "checks": checks,
    "ready_departments": ready_departments,
    "blocked_departments": blocked_departments,
    "required_to_unblock": [
        "Quality & Compliance: release_decision must be approved/ready and blocking findings must be resolved or explicitly accepted by owner.",
        "Platform Operations: provider must be real and reachable, http_status must be 200, version_match must be verified, rollback and monitoring must be production-grade.",
        "Revenue path: attach verified Polar checkout URL before Growth/Sales real send or MRR claim.",
        "Artifact binding: mvp-live evidence must include matching product_name, product_path, or product-specific artifact label before it can be reused for this product.",
    ],
    "suggested_next_commands": [
        "me solo artifact validate quality-compliance state/evidence/mvp-live.json",
        "me solo artifact validate platform-operations state/evidence/mvp-live.json",
        "me solo bottlenecks --strict",
    ],
}

packet_path = os.path.join(snapshot_dir, "release-readiness-packet.json")
with open(packet_path, "w") as f:
    json.dump(packet, f, indent=2, sort_keys=True)
    f.write("\n")

rel_packet = os.path.relpath(packet_path, root)
if os.path.exists(queue_path):
    data = json.load(open(queue_path))
    matched = None
    for item in data.get("items", []):
        if product_path and item.get("path") == product_path:
            matched = item
            break
    if matched is None:
        matches = [item for item in data.get("items", []) if item.get("name") == product_name]
        if len(matches) == 1:
            matched = matches[0]
    if matched is not None:
        matched["status"] = "active"
        matched["current_gate"] = "mvp-live"
        matched["release_readiness_packet"] = rel_packet
        matched["release_readiness_packet_status"] = packet["packet_status"]
        matched["updated_at"] = now
        matched["next_command"] = f"me solo products next {matched.get('path') or matched.get('name') or ''}".strip()
        matched["last_note"] = "release readiness packet written; not mvp-live proof"
    items = data.get("items", [])
    data["queued"] = sum(1 for item in items if item.get("status") == "queued")
    data["active"] = sum(1 for item in items if item.get("status") == "active")
    data["blocked"] = sum(1 for item in items if item.get("status") == "blocked")
    data["self_selling"] = sum(1 for item in items if item.get("status") == "self-selling")
    data["updated_at"] = now
    with open(queue_path, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")

print(f"ReleaseReadinessPacket: {rel_packet}")
print(f"PacketStatus: {packet['packet_status']}")
print(f"ReadyDepartments: {', '.join(ready_departments) if ready_departments else 'none'}")
print(f"BlockedDepartments: {', '.join(blocked_departments) if blocked_departments else 'none'}")
print("Guard: not mvp-live proof; not production proof; not campaign proof; not revenue proof")
PY
