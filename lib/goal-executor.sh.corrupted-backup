# Append "Step N Output: ..." to goal file
add_step_output() {
    local f="${1:-}"
    local n="${2:-}"
    local output="${3:-}"
    [ -z "$f" ] && f="$(latest_goal_file)"
    [ -z "$f" ] && return 1
    printf "Step %s Output: %s\n" "$n" "$output" >> "$f"
    local update_helper
    update_helper="$(goal_executor_lib_dir)/update-goal-state.py"
    [ -f "$update_helper" ] && python3 "$update_helper" "$f" "$n" 2>/dev/null || true
}
list_completed_steps() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && { echo ""; return; }
  grep -E "^Step [0-9]+ Output:" "$f" 2>/dev/null | sed "s/^Step \([0-9]\+\) Output:.*/\1/" | tr '\n' ',' | sed 's/,$//'
}

mark_step_done() {
  add_step_output "$@"
}

step_done() {
  local f="${1:-}"
  local n="${2:-}"
  grep -qE "^[[:space:]]*Step ${n} Output:" "$f" 2>/dev/null
}

# Return next step number after the highest completed step
goal_next_step() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && { echo "1"; return; }
  local steps
  steps=$(goal_field "$f" "Steps")
  if [ -z "$steps" ] || [ "$steps" = "[]" ]; then
    echo "1"; return
  fi
  echo "$steps" | tr ',' '\n' | sed 's/ //g; s/\[//g; s/\]//g' | awk '{if($1+0>m+0)m=$1} END{print m+1}'
}
