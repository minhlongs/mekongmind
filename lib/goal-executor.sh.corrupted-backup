  local limit="${1:-1}"
  local kind="${2:-both}"
  local mode="${3:-missing}"
  local queue_file
  queue_file="$(product_self_selling_queue_file)"
  [ -f "$queue_file" ] || return 1
  python3 - "$queue_file" "$limit" "$kind" "$mode" <<'PY'
import json
import sys

queue_path, raw_limit, kind, mode = sys.argv[1:5]
kind = (kind or "both").lower()
if kind not in {"release", "work", "growth", "both"}:
    raise SystemExit(f"unknown packet kind: {kind}")
force = (mode or "missing").lower() in {"force", "refresh", "all"}
data = json.load(open(queue_path))
items = data.get("items", [])

def missing_packet(item):
    if item.get("status") == "self-selling":
        return False
    if force:
        return True
    if kind == "release":
        return not item.get("release_readiness_packet")
    if kind in {"work", "growth"}:
        return not item.get("growth_sales_packet")
    return not item.get("release_readiness_packet") or not item.get("growth_sales_packet")

if (raw_limit or "").lower() in {"all", "*"}:
    limit = sum(1 for item in items if missing_packet(item))
else:
    try:
        limit = max(1, int(raw_limit))
    except ValueError:
        limit = 1

selected = []
seen = set()
for status in ("active", "queued", "blocked"):
    for item in items:
        key = item.get("path") or item.get("name")
        if not key or key in seen:
            continue
        if item.get("status") != status:
            continue
        if not missing_packet(item):
            continue
        selected.append(item.get("path") or item.get("name"))
        seen.add(key)
        if len(selected) >= limit:
            print("\n".join(selected))
            raise SystemExit(0)
if selected:
    print("\n".join(selected))
    raise SystemExit(0)
raise SystemExit(1)
PY
}

product_next_action() {
