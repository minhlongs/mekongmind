import json
import os
import sys

queue_path, query = sys.argv[1:3]
query_norm = (query or "").strip().lower()
data = json.load(open(queue_path))
items = data.get("items", [])

def resolve():
    if query_norm:
        for item in items:
            if item.get("path", "").lower() == query_norm:
                return item
        exact = [item for item in items if item.get("name", "").lower() == query_norm]
        if len(exact) == 1:
            return exact[0]
        contains = [
            item for item in items
            if query_norm in " ".join([item.get("name", ""), item.get("path", "")]).lower()
        ]
        if len(contains) == 1:
            return contains[0]
        if len(exact) > 1 or len(contains) > 1:
            raise SystemExit("ERROR: product query is ambiguous; use absolute product path")
    for status in ("active", "queued", "blocked"):
        for item in items:
            if item.get("status") == status:
                return item
    return None

item = resolve()
if not item:
    raise SystemExit("ERROR: no product found")

path = item.get("path") or item.get("name", "")
gate = item.get("current_gate", "")
status = item.get("status", "")
release_status = item.get("release_readiness_packet_status", "")
growth_status = item.get("growth_sales_packet_status", "")
current_mrr = int(float(item.get("current_mrr") or 0))
