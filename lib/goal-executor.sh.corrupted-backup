#!/bin/bash
# goal-executor.sh — Goal state manipulation for me-deep-wrapper
# Provides: latest_goal_file, goal_field, set_goal_field,
# list_completed_steps, mark_step_done, step_done,
# goal_next_step, add_step_output, create_goal

PROJECT_ROOT="${PROJECT_ROOT:-/Users/macbook/Documents/me-deep-wrapper}"
STATE_DIR="${STATE_DIR:-$PROJECT_ROOT/state}"
REVENUE_DIR="${REVENUE_DIR:-$STATE_DIR/revenue}"
GATES_DIR="${GATES_DIR:-$STATE_DIR/gates}"
DEPARTMENTS_DIR="${DEPARTMENTS_DIR:-$STATE_DIR/departments}"
PRODUCTS_DIR="${PRODUCTS_DIR:-$STATE_DIR/products}"
REGISTRY_FILE="${REGISTRY_FILE:-/Users/macbook/Documents/me-deep-wrapper/agents/registry.json}"

goal_executor_lib_dir() {
  if [ -n "${LIB_DIR:-}" ] && [ -f "$LIB_DIR/update-goal-state.py" ]; then
    echo "$LIB_DIR"
    return 0
  fi
  local source_path="${BASH_SOURCE[0]:-$0}"
  if [[ "$source_path" == */* ]]; then
    cd "$(dirname "$source_path")" 2>/dev/null && pwd
  else
    echo "/Users/macbook/Documents/me-deep-wrapper/lib"
  fi
}

if ! command -v portable_sed >/dev/null 2>&1; then
  portable_sed() {
    local expr="${1:-}"
    local file="${2:-}"
    [ -z "$expr" ] || [ -z "$file" ] && return 1
    sed -i.bak "$expr" "$file" && rm -f "${file}.bak"
  }
fi

latest_goal_file() {
  local active
  active=$(grep -l '^Status: active$' "$STATE_DIR"/goal-*.md 2>/dev/null | sort | tail -1)
  if [ -n "$active" ]; then
    echo "$active"
  else
    ls -t "$STATE_DIR"/goal-*.md 2>/dev/null | head -1
  fi
}

ensure_product_portfolio_goal_file() {
  local f="$STATE_DIR/goal-product-portfolio.md"
  mkdir -p "$STATE_DIR"
  if [ ! -f "$f" ]; then
    cat >"$f" <<'EOF'
# Goal: sell local product portfolio to $1M MRR
Status: active
CurrentGate: company-blueprint
CurrentMRR: 0
RevenueTarget: 1000000
RevenueTargetType: MRR
SoloCompanyMode: autonomous
FactoryLoop: active
EOF
  fi
  echo "$f"
}

# Usage: goal_field [<file>] <field_name>
goal_field() {
  local f="${1:-}"
  local field="${2:-}"
  if [ -n "$f" ] && [ -f "$f" ]; then :; else f="$(latest_goal_file)"; fi
  [ -z "$f" ] && { echo ""; return; }
  grep -E "^#? *${field}:" "$f" 2>/dev/null | head -1 | sed -E "s/^#? *${field}: *//"
}

set_goal_field() {
  local f="${1:-}"
  local k="${2:-}"
  local v="${3:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  if grep -qE "^${k}:" "$f" 2>/dev/null; then
    portable_sed "s|^${k}:.*|${k}: ${v}|" "$f"
  else
    echo "${k}: ${v}" >> "$f"
  fi
}

goal_id_from_file() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  basename "$f" .md
}

goal_state_dir_from_file() {
  local f="${1:-}"
  if [ -n "$f" ] && [ -f "$f" ]; then
    local dir
    dir="$(cd "$(dirname "$f")" 2>/dev/null && pwd)"
    if [ -n "$dir" ] && [ "$(basename "$dir")" = "state" ]; then
      echo "$dir"
      return 0
    fi
  fi
  echo "$STATE_DIR"
}

new_goal_stamp() {
  local stamp f attempts=0
  while :; do
    stamp=$(date +%Y%m%d-%H%M%S)
    f="$STATE_DIR/goal-${stamp}.md"
    [ ! -e "$f" ] && { echo "$stamp"; return 0; }
    attempts=$((attempts+1))
    [ "$attempts" -gt 3 ] && { echo "$stamp"; return 0; }
    sleep 1
  done
}

revenue_metrics_file() {
  local f="${1:-}"
  local gid state_dir
  gid=$(goal_id_from_file "$f") || return 1
  state_dir="$(goal_state_dir_from_file "$f")"
  echo "$state_dir/revenue/${gid}.json"
}

product_inventory_file() {
  echo "${PRODUCT_INVENTORY_FILE:-$PRODUCTS_DIR/local-product-inventory.json}"
}

product_self_selling_queue_file() {
  echo "${PRODUCT_SELF_SELLING_QUEUE_FILE:-$PRODUCTS_DIR/self-selling-queue.json}"
}

gate_state_file() {
  local f="${1:-}"
  local gid state_dir
  gid=$(goal_id_from_file "$f") || return 1
  state_dir="$(goal_state_dir_from_file "$f")"
  echo "$state_dir/gates/${gid}.json"
}


# gate_passed <goal-file> <gate-id>
# Returns 0 if the gate exists and has status "passed", else 1
# Optimized: jq replaces python3 spawn (~50ms -> ~1ms)
gate_passed() {
	local f="${1:-}" gate="${2:-}"
	[ -z "$f" ] || [ -z "$gate" ] && return 1
	local gsf
	gsf=$(gate_state_file "$f") || return 1
	[ -f "$gsf" ] || return 1
	jq -e --arg gid "$gate" '.gates[] | select(.id == $gid and .status == "passed")' "$gsf" >/dev/null 2>&1
}

department_state_file() {
  local f="${1:-}"
  local gid state_dir
  gid=$(goal_id_from_file "$f") || return 1
  state_dir="$(goal_state_dir_from_file "$f")"
  echo "$state_dir/departments/${gid}.json"
}

init_gate_state() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  local gate_file gid current_gate
  gate_file=$(gate_state_file "$f") || return 1
  gid=$(goal_id_from_file "$f") || return 1
  current_gate=$(goal_field "$f" "CurrentGate")
  [ -z "$current_gate" ] && current_gate="idea-intake"
  mkdir -p "$GATES_DIR"
  python3 - "$gate_file" "$gid" "$current_gate" <<'PY'
import json, sys
from datetime import datetime, timezone
path, goal_id, current_gate = sys.argv[1:4]
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
gates = [
    "idea-intake",
    "company-blueprint",
    "offer-validated",
    "mvp-live",
    "first-revenue",
    "repeatable-channel",
    "fulfillment-stable",
    "scale-ready",
    "first-1m-mrr",
]
data = {
    "goal_id": goal_id,
    "current_gate": current_gate,
    "updated_at": now,
    "gates": [{"id": gate, "status": "pending", "evidence": []} for gate in gates],
}
for gate in data["gates"]:
    if gate["id"] == current_gate:
        gate["status"] = "active"
        gate["evidence"].append({"at": now, "source": "local-state", "note": "initial gate"})
        break
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
  set_goal_field "$f" "GateEvidence" "$gate_file"
}

record_gate_evidence() {
  local f="${1:-}"
  local gate="${2:-}"
  local source="${3:-manual}"
  local note="${4:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  [ -z "$gate" ] && { echo "ERROR: gate required" >&2; return 1; }
  local gate_file gid
  gate_file=$(gate_state_file "$f") || return 1
  gid=$(goal_id_from_file "$f") || return 1
  [ -f "$gate_file" ] || init_gate_state "$f" >/dev/null 2>&1 || return 1
  python3 - "$gate_file" "$gid" "$gate" "$source" "$note" <<'PY'
import json, sys
from datetime import datetime, timezone
path, goal_id, gate_id, source, note = sys.argv[1:6]
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
with open(path) as f:
    data = json.load(f)
gates = data.setdefault("gates", [])
known = {gate.get("id"): gate for gate in gates}
if gate_id not in known:
    raise SystemExit(f"unknown gate: {gate_id}")
for gate in gates:
    if gate.get("status") == "active":
        gate["status"] = "passed"
for gate in gates:
    if gate.get("id") == gate_id:
        gate["status"] = "active"
        gate.setdefault("evidence", []).append({"at": now, "source": source, "note": note})
        break
data["goal_id"] = goal_id
data["current_gate"] = gate_id
data["updated_at"] = now
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
  set_goal_field "$f" "CurrentGate" "$gate"
  set_goal_field "$f" "GateEvidence" "$gate_file"
}

gate_state_summary() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  local gate_file
  gate_file=$(gate_state_file "$f") || return 1
  [ -f "$gate_file" ] || init_gate_state "$f" >/dev/null 2>&1 || return 1
  python3 - "$gate_file" <<'PY'
import json, sys
path = sys.argv[1]
canonical = [
    "idea-intake",
    "company-blueprint",
    "offer-validated",
    "mvp-live",
    "first-revenue",
    "repeatable-channel",
    "fulfillment-stable",
    "scale-ready",
    "first-1m-mrr",
]
try:
    with open(path) as f:
        data = json.load(f)
except Exception as exc:
    print(f"DRIFT gate-state invalid JSON: {path} ({exc})")
    raise SystemExit(1)
gates = data.get("gates")
if not isinstance(gates, list):
    print(f"DRIFT gate-state missing gates[]: {path}")
    raise SystemExit(1)
bad = [gate.get("id") for gate in gates if not isinstance(gate, dict) or gate.get("id") not in canonical]
if bad:
    print(f"DRIFT gate-state uses non-canonical gate ids: {', '.join(map(str, bad))}")
    print(f"Evidence: {path}")
    raise SystemExit(1)
print(f"CurrentGate: {data.get('current_gate','')}")
print(f"Evidence: {path}")
for gate in gates:
    evidence = gate.get("evidence", [])
    last = evidence[-1]["note"] if evidence else ""
    print(f"- {gate.get('id')}: {gate.get('status')} {last}")
