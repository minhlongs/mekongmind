reconcile_goal_gate_state() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  local gate_file goal_gate
  gate_file=$(gate_state_file "$f") || return 1
  goal_gate=$(goal_field "$f" "CurrentGate")
  python3 - "$f" "$gate_file" "$goal_gate" <<'PY'
import json, os, sys

goal_file, gate_file, goal_gate = sys.argv[1:4]
canonical = [
    "idea-intake",
    "company-blueprint",
    "offer-validated",
    "mvp-live",
    "first-revenue",
    "repeatable-channel",
    "fulfillment-stable",
    "scale-ready",
    "first-1m-mrr",
]
drift = []

if not os.path.exists(gate_file):
    print(f"DRIFT gate-state missing: {gate_file}")
    raise SystemExit(1)

try:
    with open(gate_file) as f:
        data = json.load(f)
except Exception as exc:
    print(f"DRIFT gate-state invalid JSON: {gate_file} ({exc})")
    raise SystemExit(1)

gates = data.get("gates")
if not isinstance(gates, list):
    drift.append("gate-state missing gates[]")
else:
    ids = []
    statuses = {}
    for gate in gates:
        if not isinstance(gate, dict):
            drift.append(f"non-object gate entry: {gate!r}")
            continue
        gid = gate.get("id")
        ids.append(gid)
        statuses[gid] = gate.get("status", "")
        if gid not in canonical:
            drift.append(f"non-canonical gate id: {gid}")
    if ids and all(gid in canonical for gid in ids):
        order = {gid: idx for idx, gid in enumerate(canonical)}
        latest_idx = max(
            [order[gid] for gid, status in statuses.items() if status in ("active", "passed")]
            or [-1]
        )
        for gid in canonical[:latest_idx]:
            if statuses.get(gid) == "pending":
                drift.append(f"later gate active/passed while previous gate pending: {gid}")

state_gate = data.get("current_gate", "")
if goal_gate and state_gate and goal_gate != state_gate:
    drift.append(f"goal CurrentGate={goal_gate} but gate-state current_gate={state_gate}")
if state_gate and state_gate not in canonical:
    drift.append(f"non-canonical current_gate: {state_gate}")

if drift:
    print("DRIFT goal/gate reconciliation failed")
    print(f"Goal: {goal_file}")
    print(f"GateState: {gate_file}")
    for item in drift:
        print(f"- {item}")
    raise SystemExit(1)

print("PASS goal/gate reconciliation")
print(f"Goal: {goal_file}")
print(f"GateState: {gate_file}")
print(f"CurrentGate: {state_gate or goal_gate}")
PY
}

authoritative_gate_for_goal() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  local current target passed
  current=$(revenue_metric_value "$f" "current_mrr" 2>/dev/null || goal_field "$f" "CurrentMRR")
  target=$(revenue_metric_value "$f" "target_mrr" 2>/dev/null || goal_field "$f" "RevenueTarget")
  [ -z "$current" ] && current=0
  [ -z "$target" ] && target=1000000
  passed="idea-intake"

  if ! validate_department_artifact "ceo-command" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "company-blueprint" "$passed" "ceo-command evidence contract missing"
    return 0
  fi
  passed="$passed,company-blueprint"

  if ! validate_department_artifact "market-intelligence" >/dev/null 2>&1 || ! validate_department_artifact "product-strategy" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "offer-validated" "$passed" "offer validation evidence contract missing"
    return 0
  fi
  passed="$passed,offer-validated"

  if ! validate_department_artifact "engineering-factory" >/dev/null 2>&1 || ! validate_department_artifact "quality-compliance" >/dev/null 2>&1 || ! validate_department_artifact "platform-operations" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "mvp-live" "$passed" "mvp-live evidence contract missing"
    return 0
  fi
  passed="$passed,mvp-live"

  if ! validate_department_artifact "growth-marketing" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "repeatable-channel" "$passed" "repeatable-channel evidence contract missing"
    return 0
  fi
  passed="$passed,repeatable-channel"

  if [ "$current" -le 0 ] || ! validate_department_artifact "sales-revenue" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "first-revenue" "$passed" "Polar-backed first revenue evidence missing"
    return 0
  fi
  passed="$passed,first-revenue"

  if ! validate_department_artifact "customer-success" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "fulfillment-stable" "$passed" "fulfillment evidence contract missing"
    return 0
  fi
  passed="$passed,fulfillment-stable"

  if ! validate_department_artifact "knowledge-memory" >/dev/null 2>&1; then
    printf "%s\t%s\t%s\n" "scale-ready" "$passed" "clone memory evidence contract missing"
    return 0
  fi
  passed="$passed,scale-ready"

  if [ "$current" -lt "$target" ]; then
    printf "%s\t%s\t%s\n" "first-1m-mrr" "$passed" "MRR gap remains $((target-current))"
    return 0
  fi
  printf "%s\t%s\t%s\n" "first-1m-mrr" "$passed,first-1m-mrr" "target reached"
}

repair_goal_gate_state() {
  local f="${1:-}"
  [ -z "$f" ] && f="$(latest_goal_file)"
  [ -z "$f" ] && return 1
  local gate_file gid gate passed reason row
  gate_file=$(gate_state_file "$f") || return 1
  gid=$(goal_id_from_file "$f") || return 1
  row=$(authoritative_gate_for_goal "$f") || return 1
  gate=$(printf '%s\n' "$row" | cut -f1)
  passed=$(printf '%s\n' "$row" | cut -f2)
  reason=$(printf '%s\n' "$row" | cut -f3-)
  mkdir -p "$GATES_DIR"
  python3 - "$gate_file" "$gid" "$gate" "$passed" "$reason" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

path, goal_id, current_gate, passed_csv, reason = sys.argv[1:6]
canonical = [
    "idea-intake",
    "company-blueprint",
    "offer-validated",
    "mvp-live",
    "repeatable-channel",
    "first-revenue",
    "fulfillment-stable",
    "scale-ready",
    "first-1m-mrr",
]
passed = {item for item in passed_csv.split(",") if item}
now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {"goal_id": goal_id}
else:
    data = {"goal_id": goal_id}
old_gates = {
    gate.get("id"): gate
    for gate in data.get("gates", [])
    if isinstance(gate, dict)
}
gates = []
for gate_id in canonical:
    old = old_gates.get(gate_id, {})
    evidence = old.get("evidence", [])
    if gate_id == current_gate:
        status = "active"
        evidence = evidence + [{"at": now, "source": "reconcile:repair", "note": reason}]
    elif gate_id in passed:
        status = "passed"
    else:
        status = "pending"
    gates.append({"id": gate_id, "status": status, "evidence": evidence})
data.update({
    "goal_id": goal_id,
    "current_gate": current_gate,
    "updated_at": now,
    "gates": gates,
})
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
  set_goal_field "$f" "CurrentGate" "$gate"
  set_goal_field "$f" "GateEvidence" "$gate_file"
  echo "REPAIRED goal/gate state"
  echo "Goal: $f"
  echo "GateState: $gate_file"
  echo "CurrentGate: $gate"
  echo "Reason: $reason"
}

