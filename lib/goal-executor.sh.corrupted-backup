  python3 - "$root" "$out" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

root, out = sys.argv[1:3]
root = os.path.abspath(os.path.expanduser(root))
marker_files = {
    "package.json": "node",
    "pnpm-lock.yaml": "pnpm",
    "yarn.lock": "yarn",
    "package-lock.json": "npm",
    "pyproject.toml": "python",
    "requirements.txt": "python",
    "go.mod": "go",
    "Cargo.toml": "rust",
    "wrangler.toml": "cloudflare-workers",
    "vercel.json": "vercel",
    "fly.toml": "fly",
    "render.yaml": "render",
    "polar.config.json": "polar",
}
ignored_dirs = {
    ".git", ".next", ".nuxt", ".turbo", ".cache", ".pytest_cache",
    "node_modules", "dist", "build", "coverage", "__pycache__",
    "Library", "Applications", "System", "Volumes", ".Trash",
    "extensions", "_work", "DerivedData",
}
secret_names = {
    ".env", ".env.local", ".env.production", ".env.development",
    "id_rsa", "id_ed25519", "secrets.json",
}

products = {}

def classify(path, files):
    detectors = sorted(marker_files[name] for name in files if name in marker_files)
    if not detectors:
        return None
    name = os.path.basename(path) or path
    package_manager = ""
    if "pnpm-lock.yaml" in files:
        package_manager = "pnpm"
    elif "yarn.lock" in files:
        package_manager = "yarn"
    elif "package-lock.json" in files or "package.json" in files:
        package_manager = "npm"
    deploy_provider = ""
    for marker, provider in (
        ("wrangler.toml", "cloudflare-workers"),
        ("vercel.json", "vercel"),
        ("fly.toml", "fly"),
        ("render.yaml", "render"),
    ):
        if marker in files:
            deploy_provider = provider
            break
    polar_signals = sorted(
        file for file in files
        if "polar" in file.lower() and file not in secret_names
    )
    return {
        "name": name,
        "path": path,
        "detectors": detectors,
        "package_manager": package_manager,
        "deploy_provider": deploy_provider,
        "polar_signals": polar_signals,
        "autonomy_gate": "company-blueprint",
        "self_selling_status": "needs-ceo-blueprint",
        "next_action": "run CEO Command to decide buyer, offer, checkout, campaign, and revenue loop",
    }

if os.path.isdir(root):
    for current, dirs, files in os.walk(root):
        dirs[:] = [
            d for d in dirs
            if d not in ignored_dirs
            and not d.startswith(".")
            and not d.startswith(".venv")
            and not d.endswith(".egg-info")
        ]
        safe_files = [f for f in files if f not in secret_names and not f.endswith(".pem")]
        product = classify(current, set(safe_files))
        if product:
            products[current] = product
            dirs[:] = [
                d for d in dirs
                if d not in {"node_modules", ".next", "dist", "build", "coverage"}
            ]
else:
    raise SystemExit(f"scan root not found: {root}")

payload = {
    "schema": "mekongmind.local_product_inventory.v1",
    "root": root,
    "updated_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "count": len(products),
    "polar_provider": "canonical",
    "secrets_policy": "secret file names are ignored; inventory records file names and product metadata only",
    "products": sorted(products.values(), key=lambda item: item["path"]),
}
with open(out, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
    f.write("\n")
print(out)
PY
}

